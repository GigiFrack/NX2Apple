From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes <hermes@local>
Date: Wed, 18 Nov 2026 01:20:03 +0000
Subject: [PATCH] host: real TCP sockets behind DM_NEXTENDO
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The offline BSD service is a self-contained datagram transport: nothing leaves the process,
every address is 127.x, and the receive queue is memory. nextendo-nex speaks PRUDP over TCP
(and TLS later), so stream sockets now get their own table, their own descriptors and the
real stack, while the datagram and EventFd paths stay byte-for-byte what they were.

Descriptors start at 512, above the offline table's range, so each entry point answers from
the right table with one compare and the old bitmasks never see a descriptor they cannot
hold. Blocking send/recv release the guest core the way the rest of the host does, poll
samples both kinds (a millisecond of granularity on a network wait), and with DM_NEXTENDO
unset a stream socket is refused exactly as before.

t_net_tcp opens a listener on 127.0.0.1, connects through the service, carries one message
each way, checks GetPeerName, and checks that the switch-off answer is still ENETDOWN.

Upstream-Status: fork-only
Reason: upstream keeps every online service cut (hle_offline.c) so there is no stream socket to speak PRUDP over; the fork needs one for Nextendo and keeps it behind DM_NEXTENDO
Issue: none opened yet — notes/nextendo-spike.md carries the plan and the open question for Nextendo
---
 dm/host/hle_net.c              | 357 ++++++++++++++++++++++++++++++++-
 dm/host/tests/Makefile         |   3 +
 dm/host/tests/t_net_eventfd.c  |   1 +
 dm/host/tests/t_net_loopback.c |   1 +
 dm/host/tests/t_net_tcp.c      | 103 ++++++++++
 5 files changed, 462 insertions(+), 3 deletions(-)
 create mode 100644 dm/host/tests/t_net_tcp.c

diff --git a/dm/host/hle_net.c b/dm/host/hle_net.c
index dd4e68b..20807fb 100644
--- a/dm/host/hle_net.c
+++ b/dm/host/hle_net.c
@@ -47,10 +47,308 @@ void dm_guest_sleep_ns(int64_t ns);
 void dm_guest_cond_wait_ns(pthread_cond_t *c, pthread_mutex_t *m, int64_t ns);
 static int sk_idle(int64_t ms) { dm_guest_sleep_ns((ms < 0 ? 100 : ms) * 1000000); return 0; }
 typedef struct { int32_t fd; int16_t events, revents; } sk_pollfd;
+
 enum { EFD_MAX = 64, SK_POLLIN = 1, SK_POLLOUT = 4, SK_POLLRDNORM = 0x40, SK_POLLWRNORM = 4, SK_POLLNVAL = 0x20,
        SK_EBADF = 9, SK_EAGAIN = 35, SK_EINVAL = 22, SK_EMSGSIZE = 40, SK_EOPNOTSUPP = 45, SK_EADDRINUSE = 48, SK_ENOTCONN = 57,
        SK_NONBLOCK = 0x800, SK_MSG_PEEK = 2, SK_MSG_DONTWAIT = 0x80, SK_UDP = 2, SK_EFD = 1,
        SK_UDP_MAX = 65507, SK_QUEUE_MAX = 1024 * 1024, SK_PACKET_MAX = 256, SK_DEFAULT_BUF = 256 * 1024 };
+
+// ---------------------------------------------------------------- Nextendo: real TCP (DM_NEXTENDO=1)
+// The service above is deliberately a self-contained datagram transport: nothing leaves the process,
+// every address is 127.x, and the receive queue is memory. A game talking to Nextendo needs the
+// opposite, so stream sockets get their own table and the real stack, and every datagram/EventFd path
+// above keeps behaving exactly as before (DM_NEXTENDO unset: dm_nd_enabled() is 0 and no branch here
+// is taken). Descriptors start at ND_TCP_BASE, above the offline table's range, so an existing entry
+// point tells the two apart with one compare and the old bitmasks never see a descriptor they cannot
+// hold. Horizon's sockaddr_in is the FreeBSD one the comment above describes: {len, family, port,
+// address} with port and address in network byte order.
+#include "hle_nextendo.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#define ND_TCP_MAX 32
+#define ND_TCP_BASE 512            // above EFD_MAX (64), inside the 1024 bits of an fd_set
+#define ND_NOT (-2)                // "not one of ours": the caller runs its datagram path
+#define ND_ENOTCONN 57
+#define ND_EPIPE 32
+#define ND_EISCONN 56
+#define ND_ECONNREFUSED 61
+#define ND_EINPROGRESS 36
+#define ND_ETIMEDOUT 60
+#define ND_EMSGSIZE 40
+
+typedef struct {
+    int used, host, nonblock, shut_r, shut_w;
+    int64_t rtimeo, stimeo;        // nanoseconds, 0 = no timeout
+    uint32_t local, peer; uint16_t local_port, peer_port;
+} nd_tcp_ent;
+
+static nd_tcp_ent g_nd_tcp[ND_TCP_MAX];
+static pthread_mutex_t g_nd_tcp_m = PTHREAD_MUTEX_INITIALIZER;
+
+static int nd_tcp_range(int fd) { int i = fd - ND_TCP_BASE; return i >= 0 && i < ND_TCP_MAX; }
+static nd_tcp_ent *nd_tcp_locked(int fd) {
+    int i = fd - ND_TCP_BASE;
+    return nd_tcp_range(fd) && g_nd_tcp[i].used ? &g_nd_tcp[i] : NULL;
+}
+static int nd_errno(int e) {
+    switch (e) {
+    case EAGAIN: return 35;
+    case EINVAL: return 22;
+    case ECONNREFUSED: return ND_ECONNREFUSED;
+    case EINPROGRESS: return ND_EINPROGRESS;
+    case ETIMEDOUT: return ND_ETIMEDOUT;
+    case EISCONN: return ND_EISCONN;
+    case EPIPE: return ND_EPIPE;
+    case ENOTCONN: return ND_ENOTCONN;
+    case EADDRINUSE: return 48;
+    case EMSGSIZE: return ND_EMSGSIZE;
+    default: return SK_ENETDOWN;
+    }
+}
+static int nd_addr_read(const void *a, unsigned n, uint32_t *addr, uint16_t *port) {
+    if (!a || n < 16) return sk_error(22);
+    const uint8_t *b = a;
+    if (b[1] != 2 || (b[0] && b[0] != 16)) return sk_error(22);
+    *port = (uint16_t)((unsigned)b[2] << 8 | b[3]);
+    *addr = (uint32_t)b[4] << 24 | (uint32_t)b[5] << 16 | (uint32_t)b[6] << 8 | b[7];
+    return 0;
+}
+static void nd_addr_write(void *a, unsigned *n, uint32_t addr, uint16_t port) {
+    if (!a) return;
+    uint8_t b[16] = {16, 2, (uint8_t)(port >> 8), (uint8_t)port,
+                     (uint8_t)(addr >> 24), (uint8_t)(addr >> 16), (uint8_t)(addr >> 8), (uint8_t)addr};
+    unsigned c = n && *n < 16 ? *n : 16;
+    memcpy(a, b, c);
+    if (n) *n = 16;
+}
+
+// A stream socket: af inet, type stream. Returns -1 with the guest errno on failure, ND_NOT when this
+// is not a stream socket at all (the caller then answers as it always did).
+int dm_nd_tcp_socket(int family, int type, int protocol) {
+    if (family != 2 || type != 1 || (protocol && protocol != 6)) return ND_NOT;
+    if (!dm_nd_enabled()) return sk_error(SK_ENETDOWN);
+    int h = (int)socket(AF_INET, SOCK_STREAM, 0);
+    if (h < 0) return sk_error(nd_errno(errno));
+    pthread_mutex_lock(&g_nd_tcp_m);
+    for (int i = 0; i < ND_TCP_MAX; i++) if (!g_nd_tcp[i].used) {
+        memset(&g_nd_tcp[i], 0, sizeof g_nd_tcp[i]);
+        g_nd_tcp[i].used = 1; g_nd_tcp[i].host = h;
+        pthread_mutex_unlock(&g_nd_tcp_m);
+        return ND_TCP_BASE + i;
+    }
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    close(h);
+    return sk_error(24);           // EMFILE
+}
+
+int dm_nd_tcp_close(int fd) {
+    if (!nd_tcp_range(fd)) return ND_NOT;
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(SK_EBADF); }
+    int h = e->host; e->used = 0; e->host = -1;
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    if (h >= 0) close(h);
+    return 0;
+}
+
+int dm_nd_tcp_bind(int fd, const void *a, unsigned n) {
+    if (!nd_tcp_range(fd)) return ND_NOT;
+    uint32_t addr = 0; uint16_t port = 0;
+    if (nd_addr_read(a, n, &addr, &port)) return -1;
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(SK_EBADF); }
+    int h = e->host;
+    e->local = addr; e->local_port = port;
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    if (!port) return 0;                       // ephemeral: the host picks one at connect time
+    struct sockaddr_in sa = {0};
+    sa.sin_family = AF_INET; sa.sin_port = htons(port);
+    sa.sin_addr.s_addr = htonl(addr);
+    int one = 1;
+    setsockopt(h, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+    if (bind(h, (struct sockaddr *)&sa, sizeof sa) < 0) return sk_error(nd_errno(errno));
+    return 0;
+}
+
+int dm_nd_tcp_connect(int fd, const void *a, unsigned n) {
+    if (!nd_tcp_range(fd)) return ND_NOT;
+    uint32_t addr = 0; uint16_t port = 0;
+    if (nd_addr_read(a, n, &addr, &port)) return -1;
+    if (!port) return sk_error(22);
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(SK_EBADF); }
+    int h = e->host, nonblock = e->nonblock;
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    struct sockaddr_in sa = {0};
+    sa.sin_family = AF_INET; sa.sin_port = htons(port); sa.sin_addr.s_addr = htonl(addr);
+    int r = connect(h, (struct sockaddr *)&sa, sizeof sa);
+    if (r < 0) {
+        int err = errno;
+        if (err == EINPROGRESS && nonblock) return sk_error(ND_EINPROGRESS);
+        return sk_error(nd_errno(err));
+    }
+    pthread_mutex_lock(&g_nd_tcp_m);
+    e->peer = addr; e->peer_port = port;
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    return 0;
+}
+
+long dm_nd_tcp_send(int fd, const void *data, unsigned long n, int flags) {
+    (void)flags;
+    if (!nd_tcp_range(fd)) return ND_NOT;
+    if (!data && n) return sk_error(22);
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(SK_EBADF); }
+    int h = e->host, nonblock = e->nonblock, shut = e->shut_w;
+    int64_t deadline = e->stimeo ? guest_ns() + e->stimeo : 0;
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    if (shut) return sk_error(ND_EPIPE);
+    for (;;) {
+        ssize_t w = send(h, data, n, MSG_NOSIGNAL);
+        if (w >= 0) return (long)w;
+        if (errno != EAGAIN && errno != EWOULDBLOCK) return sk_error(nd_errno(errno));
+        if (nonblock) return sk_error(35);
+        if (deadline && guest_ns() > deadline) return sk_error(ND_ETIMEDOUT);
+        dm_guest_sleep_ns(1000000);
+    }
+}
+
+long dm_nd_tcp_recv(int fd, void *data, unsigned long n, int flags, void *a, unsigned *al) {
+    if (!nd_tcp_range(fd)) return ND_NOT;
+    if (!data && n) return sk_error(22);
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(SK_EBADF); }
+    int h = e->host, nonblock = e->nonblock, shut = e->shut_r;
+    int64_t deadline = e->rtimeo ? guest_ns() + e->rtimeo : 0;
+    uint32_t peer = e->peer; uint16_t peer_port = e->peer_port;
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    if (shut) return 0;
+    int sysflags = (flags & 2) ? MSG_PEEK : 0;
+    for (;;) {
+        ssize_t r = recv(h, data, n, sysflags | MSG_DONTWAIT);
+        if (r >= 0) { nd_addr_write(a, al, peer, peer_port); return (long)r; }   // 0 = the peer closed
+        if (errno != EAGAIN && errno != EWOULDBLOCK) return sk_error(nd_errno(errno));
+        if (nonblock) return sk_error(35);
+        if (deadline && guest_ns() > deadline) return sk_error(35);
+        dm_guest_sleep_ns(1000000);
+    }
+}
+
+int dm_nd_tcp_shutdown(int fd, int how) {
+    if (!nd_tcp_range(fd)) return ND_NOT;
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(SK_EBADF); }
+    if (how < 0 || how > 2) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(22); }
+    int h = e->host;
+    if (how != 1) e->shut_r = 1;
+    if (how != 0) e->shut_w = 1;
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    shutdown(h, how);
+    return 0;
+}
+
+int dm_nd_tcp_name(int fd, void *a, unsigned *n, int peer) {
+    if (!nd_tcp_range(fd)) return ND_NOT;
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(SK_EBADF); }
+    int h = e->host;
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    if (peer) {
+        struct sockaddr_in sa; socklen_t sl = sizeof sa;
+        if (getpeername(h, (struct sockaddr *)&sa, &sl) < 0) return sk_error(ND_ENOTCONN);
+        nd_addr_write(a, n, ntohl(sa.sin_addr.s_addr), ntohs(sa.sin_port));
+    } else {
+        struct sockaddr_in sa; socklen_t sl = sizeof sa;
+        if (getsockname(h, (struct sockaddr *)&sa, &sl) < 0) return sk_error(22);
+        nd_addr_write(a, n, ntohl(sa.sin_addr.s_addr), ntohs(sa.sin_port));
+    }
+    return 0;
+}
+
+int dm_nd_tcp_fcntl(int fd, int cmd, int value) {
+    if (!nd_tcp_range(fd)) return ND_NOT;
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(SK_EBADF); }
+    int h = e->host, r = 0;
+    if (cmd == 3) r = e->nonblock ? SK_NONBLOCK : 0;
+    else if (cmd == 4) { e->nonblock = (value & SK_NONBLOCK) != 0; fcntl(h, F_SETFL, e->nonblock ? O_NONBLOCK : 0); }
+    else if (cmd != 1 && cmd != 2) r = sk_error(22);
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    return r;
+}
+
+int dm_nd_tcp_setopt(int fd, int level, int option, const void *value, unsigned size) {
+    if (!nd_tcp_range(fd)) return ND_NOT;
+    if (!value) return sk_error(22);
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(SK_EBADF); }
+    int h = e->host, r = 0;
+    if (level == 0xffff && (option == 0x1006 || option == 0x1005) && size >= 16) {
+        int64_t tv[2]; memcpy(tv, value, sizeof tv);
+        int64_t ns = tv[0] < 0 ? 0 : tv[0] * 1000000000 + tv[1] * 1000;
+        if (option == 0x1006) e->rtimeo = ns; else e->stimeo = ns;
+    } else if (level == 6 && option == 1 && size >= sizeof(int)) {      // IPPROTO_TCP, TCP_NODELAY
+        int v; memcpy(&v, value, sizeof v); setsockopt(h, IPPROTO_TCP, TCP_NODELAY, &v, sizeof v);
+    } else if (level == 0xffff) {
+        /* SO_REUSEADDR and friends: accepted and not needed on a stream socket here */
+    } else r = sk_error(42);
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    return r;
+}
+
+int dm_nd_tcp_getopt(int fd, int level, int option, void *value, unsigned *size) {
+    if (!nd_tcp_range(fd)) return ND_NOT;
+    if (!value || !size) return sk_error(22);
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return sk_error(SK_EBADF); }
+    int v = 0;
+    if (level == 0xffff && (option == 0x1006 || option == 0x1005) && *size >= 16) {
+        int64_t ns = option == 0x1006 ? e->rtimeo : e->stimeo;
+        int64_t tv[2] = {ns / 1000000000, ns % 1000000000 / 1000};
+        memcpy(value, tv, sizeof tv); *size = sizeof tv;
+    } else if (*size >= sizeof v) {
+        if (option == 0x1008) v = 1;            // SOCK_STREAM
+        else if (option == 0x1007) v = 0;       // IPPROTO_IP
+        else if (option == 0x1016) v = 6;       // IPPROTO_TCP
+        memcpy(value, &v, sizeof v); *size = sizeof v;
+    }
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    return 0;
+}
+
+// Readiness of one stream socket, without waiting: the poll loop below samples it.
+static int nd_tcp_ready(int fd, int16_t events) {
+    pthread_mutex_lock(&g_nd_tcp_m);
+    nd_tcp_ent *e = nd_tcp_locked(fd);
+    if (!e) { pthread_mutex_unlock(&g_nd_tcp_m); return SK_POLLNVAL; }
+    int h = e->host, shut_r = e->shut_r;
+    pthread_mutex_unlock(&g_nd_tcp_m);
+    if (shut_r) return (int)(events & (SK_POLLIN | SK_POLLRDNORM));
+    struct pollfd hp = {h, 0, 0};
+    if (events & (SK_POLLIN | SK_POLLRDNORM)) hp.events |= POLLIN;
+    if (events & (SK_POLLOUT | SK_POLLWRNORM)) hp.events |= POLLOUT;
+    if (poll(&hp, 1, 0) <= 0) return 0;
+    int rev = 0;
+    if (hp.revents & (POLLIN | POLLHUP | POLLERR)) rev |= events & (SK_POLLIN | SK_POLLRDNORM);
+    if (hp.revents & POLLOUT) rev |= events & (SK_POLLOUT | SK_POLLWRNORM);
+    return rev;
+}
 typedef struct sk_packet { struct sk_packet *next; uint32_t addr; uint16_t port; size_t size; uint8_t data[]; } sk_packet;
 static struct {
     uint64_t count, generation; int used, flags, fdflags;
@@ -78,10 +376,14 @@ static int efd_create(uint64_t v, int flags) {
     pthread_mutex_unlock(&g_efd_m); return fd;
 }
 int dm_sk_socket(int family, int type, int protocol) {
+    int tcp = dm_nd_tcp_socket(family, type, protocol);
+    if (tcp != ND_NOT) return tcp;
     if (family != 2 || type != 2 || (protocol && protocol != 17)) return sk_fail();
     dm_host_mutex_lock(&g_efd_m); int fd = sk_new_locked(SK_UDP); pthread_mutex_unlock(&g_efd_m); return fd;
 }
 int dm_sk_close(int fd) {
+    int tcp = dm_nd_tcp_close(fd);
+    if (tcp != ND_NOT) return tcp;
     dm_host_mutex_lock(&g_efd_m);
     if (!sk_used(fd)) { pthread_mutex_unlock(&g_efd_m); return sk_fail(); }
     sk_packet *p = g_efd[fd].head;
@@ -149,10 +451,14 @@ static int sk_bind_locked(int fd, uint32_t addr, uint16_t port) {
     g_efd[fd].addr = addr; g_efd[fd].port = port; return 0;
 }
 int dm_sk_bind(int fd, const void *a, unsigned n) {
+    int tcp = dm_nd_tcp_bind(fd, a, n);
+    if (tcp != ND_NOT) return tcp;
     uint32_t addr; uint16_t port; if (sk_addr_read(a, n, &addr, &port)) return -1;
     dm_host_mutex_lock(&g_efd_m); int r = sk_udp_locked(fd) ? sk_bind_locked(fd, addr, port) : sk_error(SK_EBADF); pthread_mutex_unlock(&g_efd_m); return r;
 }
 int dm_sk_connect(int fd, const void *a, unsigned n) {
+    int tcp = dm_nd_tcp_connect(fd, a, n);
+    if (tcp != ND_NOT) return tcp;
     uint32_t addr = 0; uint16_t port = 0; int disconnect = a && n >= 2 && ((const uint8_t *)a)[1] == 0;
     if (!disconnect && sk_addr_read(a, n, &addr, &port)) return -1;
     if (!disconnect && !port) return sk_error(SK_EINVAL);
@@ -163,6 +469,8 @@ int dm_sk_connect(int fd, const void *a, unsigned n) {
     pthread_mutex_unlock(&g_efd_m); return r;
 }
 int dm_sk_name(int fd, void *a, unsigned *n, int peer) {
+    int tcp = dm_nd_tcp_name(fd, a, n, peer);
+    if (tcp != ND_NOT) return tcp;
     if (!a || !n) return sk_error(SK_EINVAL);
     dm_host_mutex_lock(&g_efd_m); int r;
     if (!sk_udp_locked(fd)) r = sk_error(SK_EBADF);
@@ -171,6 +479,8 @@ int dm_sk_name(int fd, void *a, unsigned *n, int peer) {
     pthread_mutex_unlock(&g_efd_m); return r;
 }
 int dm_sk_shutdown(int fd, int how) {
+    int tcp = dm_nd_tcp_shutdown(fd, how);
+    if (tcp != ND_NOT) return tcp;
     dm_host_mutex_lock(&g_efd_m); int r = 0;
     if (!sk_udp_locked(fd)) r = sk_error(SK_EBADF);
     else if (how < 0 || how > 2) r = sk_error(SK_EINVAL);
@@ -179,6 +489,8 @@ int dm_sk_shutdown(int fd, int how) {
     pthread_mutex_unlock(&g_efd_m); return r;
 }
 int dm_sk_fcntl(int fd, int cmd, int value) {
+    int tcp = dm_nd_tcp_fcntl(fd, cmd, value);
+    if (tcp != ND_NOT) return tcp;
     dm_host_mutex_lock(&g_efd_m); int r = 0;
     if (!sk_used(fd)) r = sk_error(SK_EBADF);
     else if (cmd == 1) r = g_efd[fd].fdflags;
@@ -189,6 +501,8 @@ int dm_sk_fcntl(int fd, int cmd, int value) {
     pthread_mutex_unlock(&g_efd_m); return r;
 }
 int dm_sk_setopt(int fd, int level, int option, const void *value, unsigned size) {
+    int tcp = dm_nd_tcp_setopt(fd, level, option, value, size);
+    if (tcp != ND_NOT) return tcp;
     if (!value) return sk_error(SK_EINVAL);
     dm_host_mutex_lock(&g_efd_m); int r = 0;
     if (!sk_udp_locked(fd)) r = sk_error(SK_EBADF);
@@ -209,6 +523,8 @@ int dm_sk_setopt(int fd, int level, int option, const void *value, unsigned size
     pthread_mutex_unlock(&g_efd_m); return r;
 }
 int dm_sk_getopt(int fd, int level, int option, void *value, unsigned *size) {
+    int tcp = dm_nd_tcp_getopt(fd, level, option, value, size);
