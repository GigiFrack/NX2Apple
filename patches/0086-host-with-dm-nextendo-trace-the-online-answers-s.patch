From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes <hermes@local>
Date: Wed, 18 Nov 2026 22:27:33 +0000
Subject: [PATCH] host: with DM_NEXTENDO_TRACE the online answers say what they
 were

Upstream-Status: fork-only
Reason: A game that refuses to go online gives no reason: it asks a handful of local questions, gets a "no" or a failure
 from one of them, and goes back to its menu in the same frame. That looks identical to a switch that never arrived, and
 each guess costs a rebuild. With DM_NEXTENDO_TRACE=1 every online-facing answer prints its result in the order the game
 asked, which names the gate. Off by default and silent otherwise.
Issue: https://github.com/GigiFrack/NX2Apple (fork)

---
 dm/host/hle_account.c  |  9 ++++++---
 dm/host/hle_net.c      |  8 ++++++--
 dm/host/hle_nextendo.c | 10 ++++++++++
 dm/host/hle_nextendo.h |  4 ++++
 4 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/dm/host/hle_account.c b/dm/host/hle_account.c
index 65f58e3..4178d0e 100644
--- a/dm/host/hle_account.c
+++ b/dm/host/hle_account.c
@@ -71,8 +71,10 @@ static int nd_has_token(void) {
 HLE_FORCE("_ZN2nn7account36EnsureNetworkServiceAccountAvailableERKNS0_10UserHandleE", "network service account: the game token's identity when one is set, else the dauth chain (DM_NEXTENDO=1); cut otherwise", Result, h_acc_EnsureNsa, const UserHandle *h) {
     (void)h;
     if (!dm_nd_enabled()) return RES_FAIL;
-    if (nd_has_token()) return RES_OK;
-    return dm_acc_nsa_ensure() ? RES_FAIL : RES_OK;
+    if (nd_has_token()) { dm_nd_trace_result("account::EnsureNetworkServiceAccount(token)", RES_OK); return RES_OK; }
+    Result r = dm_acc_nsa_ensure() ? RES_FAIL : RES_OK;
+    dm_nd_trace_result("account::EnsureNetworkServiceAccount(chain)", r);
+    return r;
 }
 // The account id a game shows the network as. With a Nextendo game token in the environment it must be
 // the `pid` that token proves (`DM_NEXTENDO_PID`): the server binds the login to the account the signed
@@ -82,7 +84,7 @@ HLE_FORCE("_ZN2nn7account26GetNetworkServiceAccountIdEPNS0_23NetworkServiceAccou
     (void)h;
     if (!dm_nd_enabled()) return RES_FAIL;
     uint64_t v = 0;
-    const char *pid = getenv("DM_NEXTENDO_PID");
+    const char *pid = getenv("DM_NEXTENDO_PID");   // traced below, once the id is known
     if (pid && *pid) {
         char *end = NULL;
         v = strtoull(pid, &end, 10);
@@ -197,6 +199,7 @@ HLE_FORCE("_ZN2nn7account28DeleteSaveDataThumbnailImageERKNS0_3UidE", "save-data
 HLE_FORCE("_ZN2nn7account32IsNetworkServiceAccountAvailableEPbRKNS0_10UserHandleE", "whether the account can go online (DM_NEXTENDO=1); false otherwise", Result, h_acc_NsaAvail, uint8_t *out, const UserHandle *h) {
     (void)h;
     *out = nd_has_token() || (dm_nd_enabled() && dm_acc_nsa_available());
+    dm_nd_trace_result("account::IsNetworkServiceAccountAvailable", *out);
     return RES_OK;
 }
 HLE_FORCE("_ZN2nn7account9CloseUserERKNS0_10UserHandleE", "close user; the handle holds no session", void, h_acc_CloseUser, const UserHandle *h) { (void)h; }
diff --git a/dm/host/hle_net.c b/dm/host/hle_net.c
index fb48e2e..7f2e1b8 100644
--- a/dm/host/hle_net.c
+++ b/dm/host/hle_net.c
@@ -24,16 +24,20 @@ static _Atomic int g_nifm_hold;   // queries the pending request still answers "
 // otherwise wait for a rejection that never turns into a yes.
 HLE_FORCE("_ZN2nn4nifm20SubmitNetworkRequestEv", "offline: the request is on hold for the first query, then settles as unavailable; DM_NEXTENDO=1: it settles at once", void, h_nifm_Submit, void) {
     atomic_store(&g_nifm_hold, dm_nd_enabled() ? 0 : 1);
+    dm_nd_trace_result("nifm::SubmitNetworkRequest(ok)", RES_OK);
 }
 HLE_FORCE("_ZN2nn4nifm20CancelNetworkRequestEv", "offline: drops the pending request", void, h_nifm_Cancel, void) { atomic_store(&g_nifm_hold, 0); }
 HLE_FORCE("_ZN2nn4nifm22IsNetworkRequestOnHoldEv", "offline: on hold for the first query after the submission", int, h_nifm_OnHold, void) {
     int h = atomic_load(&g_nifm_hold);
     while (h > 0 && !atomic_compare_exchange_weak(&g_nifm_hold, &h, h - 1)) {}
+    dm_nd_trace_result("nifm::IsNetworkRequestOnHold", h > 0);
     return h > 0;
 }
 // The gate a game asks before it offers anything online. Offline it stays a plain no.
 HLE_FORCE("_ZN2nn4nifm18IsNetworkAvailableEv", "offline: the network is always unavailable; DM_NEXTENDO=1 reports it up", int, h_nifm_Available, void) {
-    return dm_nd_enabled() ? 1 : 0;
+    int up = dm_nd_enabled() ? 1 : 0;
+    dm_nd_trace_result("nifm::IsNetworkAvailable", up);
+    return up;
 }
 // Returns bool (`and w0, w0, #1`, Metroid Dread's sdk+0x336210): whether the system's network screen resolved the error
 HLE_FORCE("_ZN2nn4nifm31HandleNetworkRequestErrorResultEv", "offline: not resolved, shows no system network screen", unsigned, h_nifm_HandleErr, void) { return 0; }
@@ -47,7 +51,7 @@ HLE_FORCE("_ZN2nn4nifm26GetCurrentPrimaryIpAddressEPNS_6socket6InAddrE", "offlin
     if (a) *a = 0;
     return RES_FAIL;
 }
-HLE_FORCE("_ZN2nn4nifm22GetCurrentProxySettingEPNS0_12ProxySettingE", "offline: no proxy setting", Result, h_nifm_GetProxy, void *p) { (void)p; return RES_FAIL; }
+HLE_FORCE("_ZN2nn4nifm22GetCurrentProxySettingEPNS0_12ProxySettingE", "offline: no proxy setting", Result, h_nifm_GetProxy, void *p) { (void)p; dm_nd_trace_result("nifm::GetCurrentProxySetting(fail)", RES_FAIL); return RES_FAIL; }
 HLE_FORCE("nnsslInitialize", "connects to the ssl service; the network library's global init needs it to succeed, offline creates no session (cut)", Result, h_ssl_Initialize, void) { return RES_OK; }
 HLE_FORCE("nnsslFinalize", "pairs with nnsslInitialize (cut)", Result, h_ssl_Finalize, void) { return RES_OK; }
 
diff --git a/dm/host/hle_nextendo.c b/dm/host/hle_nextendo.c
index b501033..d62d83f 100644
--- a/dm/host/hle_nextendo.c
+++ b/dm/host/hle_nextendo.c
@@ -170,6 +170,16 @@ static int nd_match(const char *pattern, const char *host) {
     return strcasecmp(host, pattern) == 0;
 }
 
+int dm_nd_trace(void) {
+    const char *e = getenv("DM_NEXTENDO_TRACE");
+    return e && e[0] == '1';
+}
+
+//: One line per answered call: the game's own order of questions is what names the gate it stops at.
+void dm_nd_trace_result(const char *what, long long value) {
+    if (dm_nd_trace()) fprintf(stderr, "[dm] nextendo: %s -> %lld\n", what, value);
+}
+
 // The last name that resolved through this map. A game that opens TLS to a bare address sends no
 // hostname, and Nextendo's router reads the SNI to pick the service, so the TLS layer asks for this
 // (`SslManagedSocketConnection.cs` reconstructs it the same way).
diff --git a/dm/host/hle_nextendo.h b/dm/host/hle_nextendo.h
index 25db0e4..bb20310 100644
--- a/dm/host/hle_nextendo.h
+++ b/dm/host/hle_nextendo.h
@@ -14,6 +14,10 @@ void dm_nd_reload(void);
 //: `addrs` holds up to `max` addresses in host byte order, same as in_addr.s_addr.
 int dm_nd_lookup(const char *host, uint32_t *addrs, int max);
 
+//: DM_NEXTENDO_TRACE=1: print every online-facing answer, so a game that gives up says where.
+int dm_nd_trace(void);
+void dm_nd_trace_result(const char *what, long long value);
+
 //: The last hostname this map resolved, for the SNI of a connection the game opened by address.
 const char *dm_nd_last_host(void);
 
