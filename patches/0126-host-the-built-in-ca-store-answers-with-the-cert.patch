diff --git a/dm/host/tests/t_ssl_certs.c b/dm/host/tests/t_ssl_certs.c
new file mode 100644
index 0000000..754d34d
--- /dev/null
+++ b/dm/host/tests/t_ssl_certs.c
@@ -0,0 +1,138 @@
+// The built-in CA store: the layout a title walks (the entries, the terminator after them, the DER data behind
+// the table) and the one certificate every title so far asks for by id - NintendoCAG3, CaCertificateId 1.
+//
+// Super Mario Party Jamboree stops on an empty store: it asks for id 1 as soon as it has a name for the NPLN
+// front end, and an empty answer is err::ShowError 0x270141 with not one nnsocketSocket in the trace. So what
+// this test pins is that the answer is never empty, that the walk ends at the terminator, and that a
+// certificate dropped in <game data>/certs/<id>.der replaces the built-in stand-in without a build.
+#include "../hle_net.c"
+#include "../hle_ssl.c"
+#include "../hle_nextendo.c"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+
+// The object map hle_ssl.c hangs its state off: the host has a real one, this test a table.
+#define TEST_OBJ_MAX 8
+static struct { const void *guest; void *host; } g_obj[TEST_OBJ_MAX];
+
+void *objmap_get(const void *guest) {
+    for (int i = 0; i < TEST_OBJ_MAX; i++) if (g_obj[i].guest == guest) return g_obj[i].host;
+    return NULL;
+}
+void objmap_put(const void *guest, void *host) {
+    for (int i = 0; i < TEST_OBJ_MAX; i++) if (!g_obj[i].guest || g_obj[i].guest == guest) {
+        g_obj[i].guest = guest; g_obj[i].host = host; return;
+    }
+    fprintf(stderr, "objmap full\n"); exit(1);
+}
+void *objmap_del(const void *guest) {
+    for (int i = 0; i < TEST_OBJ_MAX; i++) if (g_obj[i].guest == guest) {
+        void *h = g_obj[i].host; g_obj[i].guest = NULL; g_obj[i].host = NULL; return h;
+    }
+    return NULL;
+}
+
+__thread _Atomic int dm_host_work;
+
+void dm_guest_sleep_ns(int64_t ns) {
+    struct timespec ts = {ns / 1000000000, ns % 1000000000};
+    nanosleep(&ts, NULL);
+}
+void dm_guest_cond_wait_ns(pthread_cond_t *c, pthread_mutex_t *m, int64_t ns) {
+    struct timespec now, abs;
+    clock_gettime(CLOCK_REALTIME, &now);
+    abs.tv_sec = now.tv_sec + ns / 1000000000;
+    abs.tv_nsec = now.tv_nsec + ns % 1000000000;
+    if (abs.tv_nsec >= 1000000000) { abs.tv_sec++; abs.tv_nsec -= 1000000000; }
+    pthread_cond_timedwait(c, m, &abs);
+}
+uint64_t guest_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000u + (uint64_t)ts.tv_nsec;
+}
+int dm_detclock_enabled(void) { return 0; }
+
+uint8_t *dm_guest_base(void) { return NULL; }   // only die() would want it
+
+// BuiltInCertificateInfo, the 0x18 bytes the SDK walks: id, status, der_size, der_offset.
+struct info { uint32_t id, status; uint64_t size, off; };
+
+int main(void) {
+    setenv("DM_NEXTENDO", "1", 1);
+    dm_nd_reload();
+
+    static uint8_t buf[0x4000];
+    void *out = NULL;
+    uint32_t size = 0;
+
+    // ---- the question a title asks: id 1, and the answer is a certificate and its terminator
+    uint32_t id = 1;
+    assert(h_ssl_BiBufSize(&size, &id, 1) == RES_OK);
+    assert(size > 2 * 0x18);
+    assert(h_ssl_BiCerts(&out, buf, sizeof buf, &id, 1) == RES_OK);
+    assert(out == buf);
+    struct info *e = (struct info *)(void *)buf;
+    assert(e[0].id == 1);
+    assert(e[0].status == 1);                     // TrustedCertStatus::EnabledTrusted
+    assert(e[0].size > 0);
+    assert(e[0].off == 2 * 0x18);                 // behind the table, the terminator slot included
+    assert(e[0].off + e[0].size <= size);
+    assert(buf[e[0].off] == 0x30);                // a DER SEQUENCE, not a stub
+    struct info *term = (struct info *)(void *)(buf + 0x18);
+    assert(term->id == 0xffffffffu);              // All: the walk stops here
+    assert(term->size == 0 && term->off == 0);
+    assert(size == 2 * 0x18 + ((e[0].size + 3u) & ~(uint64_t)3u));
+
+    // ---- All (-1) is the same store: the one certificate this host has
+    uint32_t all = 0xffffffffu, size_all = 0;
+    assert(h_ssl_BiBufSize(&size_all, &all, 1) == RES_OK);
+    assert(size_all == size);
+    printf("id 1 and id All: %llu-byte DER behind the table, terminator after it\n",
+           (unsigned long long)e[0].size);
+
+    // ---- an id the store does not have is legal too, and is still a list a caller can walk
+    uint32_t other = 4000;
+    assert(h_ssl_BiBufSize(&size, &other, 1) == RES_OK);
+    assert(size == 0x18);                         // the terminator alone
+    out = NULL;
+    assert(h_ssl_BiCerts(&out, buf, sizeof buf, &other, 1) == RES_OK);
+    assert(out == buf);
+    assert(((struct info *)(void *)buf)->id == 0xffffffffu);
+    printf("an unknown id: terminator only, the walk still ends\n");
+
+    // ---- a certificate the user dropped in wins over the built-in one
+    static const uint8_t fake[] = {0x30, 0x82, 0x00, 0x10, 0x02, 0x01, 0x01, 0x30, 0x05, 0x06, 0x03, 0x55, 0x04, 0x03,
+                                   0x04, 0x00, 0x00, 0x00};   // any bytes: the store hands them through
+    char dir[] = "/tmp/dm_ssl_ca_XXXXXX";
+    assert(mkdtemp(dir) != NULL);
+    char path[512];
+    snprintf(path, sizeof path, "%s/certs", dir);
+    assert(mkdir(path, 0755) == 0);
+    snprintf(path, sizeof path, "%s/certs/1.der", dir);
+    FILE *f = fopen(path, "wb");
+    assert(f && fwrite(fake, 1, sizeof fake, f) == sizeof fake);
+    fclose(f);
+    snprintf(path, sizeof path, "%s/romfs.img", dir);
+    setenv("DM_ROMFS", path, 1);
+
+    assert(h_ssl_BiBufSize(&size, &id, 1) == RES_OK);
+    assert(size == 2 * 0x18 + ((sizeof fake + 3u) & ~(size_t)3u));
+    out = NULL;
+    assert(h_ssl_BiCerts(&out, buf, sizeof buf, &id, 1) == RES_OK);
+    e = (struct info *)(void *)buf;
+    assert(e[0].size == sizeof fake);
+    assert(memcmp(buf + e[0].off, fake, sizeof fake) == 0);
+    printf("certs/1.der: %zu bytes from the file, the built-in one untouched\n", sizeof fake);
+
+    // ---- without the switch it is the old failure, so nothing here changes an offline title
+    unsetenv("DM_NEXTENDO");
+    out = NULL;
+    assert(h_ssl_BiCerts(&out, buf, sizeof buf, &id, 1) == RES_FAIL);
+    assert(out == NULL);
+    printf("offline: fails, as the cut branch always did\n");
+    printf("ok\n");
+    return 0;
+}
