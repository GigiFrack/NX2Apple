-// store is legal, and the peer is verified by the host's TLS layer, not against this list.
-HLE_FORCE("_ZN2nn3ssl14BuiltInManager22GetBuiltInCertificatesEPPNS0_26BuiltInCertificateInfoBaseEPhjPNS0_15CaCertificateIdEj", "the built-in certificate store is empty (the peer is verified by the host's TLS layer)", Result, h_ssl_Certs,
-          void **out, uint8_t *buf, unsigned bn, void *ids, unsigned n) { (void)bn; (void)ids; (void)n;
+// SDK 17's spelling of the same question (the certificate list is a base class there): the same store, filled by
+// the same code as hle_ssl.c's entry (hle_ssl_ca.h). Offline it is a failure, exactly as before.
+HLE_FORCE("_ZN2nn3ssl14BuiltInManager22GetBuiltInCertificatesEPPNS0_26BuiltInCertificateInfoBaseEPhjPNS0_15CaCertificateIdEj", "the built-in CA store: a stand-in for NintendoCAG3, or <game data>/certs/1.der when the user dropped the real one", Result, h_ssl_Certs,
+          void **out, uint8_t *buf, unsigned bn, void *ids, unsigned n) {
     if (!dm_nd_enabled()) { if (out) *out = NULL; return RES_FAIL; }
-    if (buf && bn >= 0x18) { uint32_t *e = (uint32_t *)buf;
-        e[0] = 0xffffffffu; e[1] = 0xffffffffu; memset(buf + 8, 0, 0x10); if (out) *out = (void *)buf; }
-    else if (out) *out = NULL;
-    { char t[96]; snprintf(t, sizeof t, "ssl::BuiltInCertificates(SDK 17, buf=%p size=%u ids=%u) -> terminator", (void *)buf, bn, n);
-      dm_nd_trace_result(t, 0); } return RES_OK; }
+    unsigned entries = 0; size_t der = 0; int file = 0;
+    size_t size = dm_ssl_ca_build((const unsigned *)ids, n, buf, bn, &entries, &der, &file);
+    if (out) *out = size ? (void *)buf : NULL;
+    { char t[152]; snprintf(t, sizeof t, "ssl::BuiltInCertificates(SDK 17, buf=%p size=%u ids=%u) -> %u certificate(s), der %zu %s",
+                             (void *)buf, bn, n, entries, der, file ? "from certs/<id>.der" : "built-in");
+      dm_nd_trace_result(t, (long long)entries); }
+    return size ? RES_OK : RES_FAIL;
+}
 
