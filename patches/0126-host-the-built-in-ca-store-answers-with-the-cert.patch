+#define DM_SSL_CA_INFO     0x18u         // sizeof(BuiltInCertificateInfo)
+#define DM_SSL_CA_TRUSTED  1u            // TrustedCertStatus::EnabledTrusted
+#define DM_SSL_CA_MAX      8192u         // the most a <id>.der may weigh
