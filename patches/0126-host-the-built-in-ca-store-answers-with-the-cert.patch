+    0x58, 0xfe, 0xc3, 0xc9, 0x1b, 0x84, 0x08, 0x8e, 0xae, 0xd2, 0x76, 0xb8,
+    0x74, 0x87, 0x94, 0xd7, 0x4b, 0x96, 0x1e, 0x60, 0x2a, 0x8d, 0xb5, 0x80,
+    0x1b, 0xbb, 0x41, 0xcf, 0x23, 0x83, 0x22, 0xec, 0x64, 0xf3, 0x9e, 0xb0,
+    0xa8, 0x03, 0xfe, 0x64, 0xbe, 0x85, 0xe3, 0xf4, 0x24, 0x37, 0xb8, 0x86,
+    0xb3, 0x08, 0x57, 0xb5, 0xe5, 0x8c, 0xa0, 0x1a, 0x11, 0x08, 0x5b, 0x9b,
+    0xa0, 0x3f, 0xe3, 0x91, 0x76, 0xce, 0x8e, 0xa8, 0x23, 0xcc, 0xc2, 0x59,
+    0xfe, 0x9f, 0xc2, 0x99, 0x1a, 0x45, 0xe8, 0x7c, 0x79, 0x38, 0x8d, 0xa3,
+    0x07, 0xb5, 0x32, 0xfa, 0x0e, 0x64, 0x31, 0xef, 0xf1, 0x45, 0xae, 0x43,
+    0xdd, 0x4d, 0x8c, 0x15, 0x34, 0x19, 0xeb, 0x3f, 0xde, 0xca, 0xa4, 0xbe,
+    0x5d, 0x14, 0x14, 0xa8, 0x93, 0x0c, 0xf2, 0x95, 0x07,
+};
+
+// <game data>/certs/<id>.der. The folder is the one the shell handed the game: DM_ROMFS points at
+// romfs.img inside it, DM_SAVE at its save folder.
+static int dm_ssl_ca_path(unsigned id, char *out, size_t cap) {
+    const char *base = getenv("DM_ROMFS");
+    if (!base || !*base) base = getenv("DM_SAVE");
+    if (!base || !*base) return 0;
+    const char *slash = strrchr(base, '/');
+    if (!slash) return 0;
+    int n = snprintf(out, cap, "%.*s/certs/%u.der", (int)(slash - base), base, id);
+    return n > 0 && (size_t)n < cap;
+}
+
+// The size of the file for this id, 0 when there is none (or it is bigger than any certificate).
+static size_t dm_ssl_ca_file_len(unsigned id) {
+    char path[1024];
+    if (!dm_ssl_ca_path(id, path, sizeof path)) return 0;
+    FILE *f = fopen(path, "rb");
+    if (!f) return 0;
+    long n = -1;
+    if (fseek(f, 0, SEEK_END) == 0) n = ftell(f);
+    fclose(f);
+    return n > 0 && (unsigned long)n <= DM_SSL_CA_MAX ? (size_t)n : 0;
+}
+
+// How many bytes of DER this id has: the dropped file first, the built-in one for NintendoCAG3, else none.
+static size_t dm_ssl_ca_len(unsigned id) {
+    size_t n = dm_ssl_ca_file_len(id);
+    if (n) return n;
+    return id == DM_SSL_CA_NINTENDO ? sizeof dm_ssl_ca_builtin : 0;
+}
+
+// Copies that DER out; `from_file` says which source answered (for the trace).
+static size_t dm_ssl_ca_copy(unsigned id, unsigned char *out, size_t cap, int *from_file) {
+    size_t n = dm_ssl_ca_file_len(id);
+    if (n && n <= cap) {
+        char path[1024];
+        if (dm_ssl_ca_path(id, path, sizeof path)) {
+            FILE *f = fopen(path, "rb");
+            if (f) {
+                size_t got = fread(out, 1, n, f);
+                fclose(f);
+                if (got == n) { if (from_file) *from_file = 1; return n; }
+            }
+        }
+    }
+    if (id == DM_SSL_CA_NINTENDO && sizeof dm_ssl_ca_builtin <= cap) {
+        memcpy(out, dm_ssl_ca_builtin, sizeof dm_ssl_ca_builtin);
+        if (from_file) *from_file = 0;
+        return sizeof dm_ssl_ca_builtin;
+    }
+    return 0;
+}
+
+// How many bytes the store for these ids needs: one entry per certificate this host can answer for, the
+// terminator, and the DER data behind the table, each 4-byte aligned.
+static size_t dm_ssl_ca_size(const unsigned *ids, unsigned n) {
+    size_t total = DM_SSL_CA_INFO;                              // the terminator entry alone, at worst
+    for (unsigned i = 0; i < n; i++) {
+        size_t len = dm_ssl_ca_len(ids[i] == DM_SSL_CA_ALL ? DM_SSL_CA_NINTENDO : ids[i]);
+        if (!len) continue;
+        total += DM_SSL_CA_INFO + ((len + 3u) & ~(size_t)3u);
+    }
+    return total;
+}
+
+// Writes that store and returns its size (0 when the buffer is too small, or nothing could be written).
+// `entries` reports how many certificates went in, `from_file` whether the first one came from a file.
+static size_t dm_ssl_ca_build(const unsigned *ids, unsigned n, unsigned char *buf, size_t cap,
+                              unsigned *entries, size_t *der_size, int *from_file) {
+    size_t need = dm_ssl_ca_size(ids, n);
+    if (entries) *entries = 0;
+    if (der_size) *der_size = 0;
+    if (from_file) *from_file = 0;
+    if (!buf || cap < need) return 0;
+
+    unsigned k = 0;
+    for (unsigned i = 0; i < n; i++) if (dm_ssl_ca_len(ids[i] == DM_SSL_CA_ALL ? DM_SSL_CA_NINTENDO : ids[i])) k++;
+
+    size_t at = (size_t)(k + 1) * DM_SSL_CA_INFO;               // the DER data starts behind the table
+    unsigned j = 0;
+    for (unsigned i = 0; i < n; i++) {
+        unsigned id = ids[i] == DM_SSL_CA_ALL ? DM_SSL_CA_NINTENDO : ids[i];
+        size_t len = dm_ssl_ca_len(id);
+        if (!len) continue;
+        uint32_t *slot = (uint32_t *)(void *)(buf + (size_t)j * DM_SSL_CA_INFO);
+        slot[0] = id;
+        slot[1] = DM_SSL_CA_TRUSTED;
+        uint64_t size = (uint64_t)len, off = (uint64_t)at;
+        memcpy(slot + 2, &size, 8);                            // der_size
+        memcpy(slot + 4, &off, 8);                             // der_offset
+        int file = 0;
+        if (dm_ssl_ca_copy(id, buf + at, cap - at, &file) != len) return 0;
+        if (!j) { if (der_size) *der_size = len; if (from_file) *from_file = file; }
+        at += (len + 3u) & ~(size_t)3u;
+        j++;
+    }
+
+    // The terminator: id All (all ones, so the id reads -1 whichever half a caller looks at), status
+    // invalid, no data. The caller walks the table until it sees it.
+    uint32_t *t = (uint32_t *)(void *)(buf + (size_t)k * DM_SSL_CA_INFO);
+    t[0] = DM_SSL_CA_ALL;
+    t[1] = 0;
+    t[2] = t[3] = t[4] = t[5] = 0;
+
+    if (entries) *entries = j;
+    return need;
+}
