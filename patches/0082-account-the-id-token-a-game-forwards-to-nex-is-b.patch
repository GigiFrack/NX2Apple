diff --git a/dm/host/tests/t_idtoken.c b/dm/host/tests/t_idtoken.c
new file mode 100644
index 0000000..e5e78f6
--- /dev/null
+++ b/dm/host/tests/t_idtoken.c
@@ -0,0 +1,128 @@
+// The BAAS id_token's shape: what a game reads out of it, and what it must never contain.
+// Portable: the signer is a fake here, so this runs on the Linux box as well as in the macOS CI.
+#include "../dmidtoken.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>                 // atoll
+#include <string.h>
+#include <time.h>
+
+// A 512-byte "signature" that is a function of the message, so a wrong message would show.
+static size_t fake_sign(const void *msg, size_t len, void *sig, size_t cap) {
+    const unsigned char *m = (const unsigned char *)msg;
+    unsigned char *s = (unsigned char *)sig;
+    if (cap < 512) return 0;
+    unsigned h = 2166136261u;
+    for (size_t i = 0; i < len; i++) { h ^= m[i]; h *= 16777619u; }
+    for (size_t i = 0; i < 256; i++) { s[i * 2] = (unsigned char)(h >> (i % 4 * 8)); s[i * 2 + 1] = (unsigned char)i; }
+    return 512;
+}
+
+static size_t refuse_sign(const void *msg, size_t len, void *sig, size_t cap) {
+    (void)msg; (void)len; (void)sig; (void)cap;
+    return 0;
+}
+
+// base64url without padding: alphabet, and `=` must never appear.
+static void check_b64url(const char *s) {
+    assert(strchr(s, '=') == NULL);
+    assert(strchr(s, '+') == NULL && strchr(s, '/') == NULL);
+    for (const char *p = s; *p; p++)
+        assert((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') || (*p >= '0' && *p <= '9') ||
+               *p == '-' || *p == '_');
+}
+
+//: The payload of a JWT, decoded: the claims are ASCII, so a straight base64url decode does.
+static void decode_payload(const char *jwt, char *json, size_t cap) {
+    static const char A[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+    const char *d1 = strchr(jwt, '.');
+    const char *d2 = strrchr(jwt, '.');
+    size_t o = 0;
+    unsigned acc = 0;
+    int bits = 0;
+    for (const char *p = d1 + 1; p < d2 && o + 1 < cap; p++) {
+        const char *q = strchr(A, *p);
+        assert(q);
+        acc = acc << 6 | (unsigned)(q - A);
+        bits += 6;
+        if (bits >= 8) { bits -= 8; json[o++] = (char)((acc >> bits) & 0xFF); }
+    }
+    json[o] = 0;
+}
+
+int main(void) {
+    char out[DM_IDTOKEN_MAX];
+    size_t n = dm_idtoken_build(out, sizeof out, "nx2.abc.def", "2.4.0", NULL, fake_sign);
+    assert(n > 0);
+    assert(n == strlen(out));
+
+    // Three dot-separated parts, all base64url.
+    int dots = 0;
+    for (char *p = out; *p; p++) if (*p == '.') dots++;
+    assert(dots == 2);
+    char head[512], payload[1024];
+    const char *d1 = strchr(out, '.');
+    const char *d2 = strrchr(out, '.');
+    assert(d1 && d2 && d1 != d2);
+    memcpy(head, out, (size_t)(d1 - out)); head[d1 - out] = 0;
+    memcpy(payload, d1 + 1, (size_t)(d2 - d1 - 1)); payload[d2 - d1 - 1] = 0;
+    check_b64url(head);
+    check_b64url(payload);
+    check_b64url(d2 + 1);
+
+    // Decoded payload: the claims a game and the server read.
+    char json[800];
+    // Only ASCII claims, so a base64url decode is a small loop.
+    static const char ALPHA[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+    size_t o = 0;
+    unsigned acc = 0; int bits = 0;
+    for (const char *p = payload; *p && o + 1 < sizeof json; p++) {
+        const char *q = strchr(ALPHA, *p);
+        assert(q);
+        acc = acc << 6 | (unsigned)(q - ALPHA); bits += 6;
+        if (bits >= 8) { bits -= 8; json[o++] = (char)((acc >> bits) & 0xFF); }
+    }
+    json[o] = 0;
+    assert(strstr(json, "\"nnex\":\"nx2.abc.def\""));
+    assert(strstr(json, "\"iss\":\"https://e0d67c509fb203858ebcb2fe3f88c2aa.baas.nintendo.com\""));
+    assert(strstr(json, "\"aud\":\"ted9e2f05d286f7b8\""));
+    assert(strstr(json, "\"tv\":\"2.4.0\""));
+    assert(strstr(json, "\"sn\":\"XAW10000000000\""));
+    assert(strstr(json, "\"hm\":true"));
+    assert(strstr(json, "\"jku\":\"https://e0d67c509fb203858ebcb2fe3f88c2aa.baas.nintendo.com/1.0.0/certificates\""));
+    assert(strstr(json, "\"app_id\"") == NULL);          // only for the titles that need it
+    // exp - iat is the three hours the reference client uses.
+    const char *iat = strstr(json, "\"iat\":");
+    const char *exp = strstr(json, "\"exp\":");
+    assert(iat && exp);
+    // Numeric claims, not strings: a JWT validator refuses `"iat":"123"`.
+    assert(iat[6] >= '0' && iat[6] <= '9');
+    assert(exp[6] >= '0' && exp[6] <= '9');
+    assert((time_t)(atoll(exp + 6) - atoll(iat + 6)) == DM_IDTOKEN_TTL_SECONDS);
+
+    // Two tokens never repeat: the random claims differ.
+    char again[DM_IDTOKEN_MAX];
+    assert(dm_idtoken_build(again, sizeof again, "nx2.abc.def", "2.4.0", NULL, fake_sign) > 0);
+    assert(strcmp(again, out) != 0);
+
+    // The app id goes in only when asked.
+    assert(dm_idtoken_build(out, sizeof out, "nx2.abc.def", "2.4.0", "0100D870045B6000", fake_sign) > 0);
+    char with_app[1024];
+    decode_payload(out, with_app, sizeof with_app);
+    assert(strstr(with_app, "\"app_id\":\"0100D870045B6000\""));
+
+    // No version, no `tv` claim (the field is optional in the reference).
+    assert(dm_idtoken_build(out, sizeof out, "nx2.abc.def", NULL, NULL, fake_sign) > 0);
+
+    // Refusals: no token, no signer, or a buffer that cannot hold the result.
+    assert(dm_idtoken_build(out, sizeof out, NULL, "2.4.0", NULL, fake_sign) == 0);
+    assert(dm_idtoken_build(out, sizeof out, "", "2.4.0", NULL, fake_sign) == 0);
+    assert(dm_idtoken_build(out, sizeof out, "nx2.abc.def", "2.4.0", NULL, NULL) == 0);
+    assert(dm_idtoken_build(out, sizeof out, "nx2.abc.def", "2.4.0", NULL, refuse_sign) == 0);
+    char tiny[64];
+    assert(dm_idtoken_build(tiny, sizeof tiny, "nx2.abc.def", "2.4.0", NULL, fake_sign) == 0);
+
+    printf("ok: %zu bytes, claims and refusals\n", n);
+    return 0;
+}
