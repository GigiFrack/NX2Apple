diff --git a/dm/host/hle_ssl.c b/dm/host/hle_ssl.c
new file mode 100644
index 0000000..eed6145
--- /dev/null
+++ b/dm/host/hle_ssl.c
@@ -0,0 +1,218 @@
+// nn::ssl over SecureTransport, on top of the guest's own socket descriptor.
+//
+// Every call the games make already had a name in hle_net.c (the SSF/SSC stubs): this unit gives the
+// ones that need a real connection a body. The TLS stack is the platform's — no vendored library —
+// and it is driven through SSLSetIOFuncs over dm_sk_recvfrom/dm_sk_sendto, so the guest's blocking
+// or non-blocking mode, its timeouts and its errno stay in one place (hle_net.c), which is also what
+// makes the handshake work on a socket the game created with nn::socket.
+//
+// With DM_NEXTENDO unset every entry answers exactly what the stub answered before: a context is
+// created and destroyed successfully, a connection's calls fail, Read and Write return -1.
+#include "hle.h"
+#include "hle_net.h"
+#include "hle_nextendo.h"
+#include "hle_ssl.h"
+
+// The guest's MSG_DONTWAIT, as hle_net.c's SK_MSG_DONTWAIT defines it for the socket service.
+#define DM_SK_MSG_DONTWAIT 0x80
+
+#include <Security/SecureTransport.h>
+#include <Security/Security.h>
+#include <string.h>
+
+// SecureTransport is deprecated since iOS 13 ("use Network.framework"), which is asynchronous and
+// block-based while every nn::ssl call here is blocking. The API is present in every iPhoneOS SDK,
+// so the port keeps the synchronous one and says so once, here.
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+
+typedef struct {
+    uint64_t id;
+    int verify;                       // 0 none, 1 peer, 2 peer+host (Horizon's VerifyOption)
+    int conns;
+} dm_ssl_ctx;
+
+typedef struct {
+    SSLContextRef st;
+    int fd;
+    char host[256];
+    int io_mode;                      // 0 blocking, 1 non-blocking (Horizon's IoMode)
+    int verify;                       // Horizon's VerifyOption: 0 asks for no verification
+    int handshaked;
+    int last_error;                   // the OSStatus of the last failure, for GetLastError
+} dm_ssl_conn;
+
+// ---------------------------------------------------------------- the IO the handshake runs on
+
+static OSStatus dm_ssl_io_read(SSLConnectionRef ref, void *data, size_t *len) {
+    dm_ssl_conn *c = (dm_ssl_conn *)ref;
+    long r = dm_sk_recvfrom(c->fd, data, *len, c->io_mode ? DM_SK_MSG_DONTWAIT : 0, NULL, NULL);
+    if (r < 0) {
+        *len = 0;
+        return c->io_mode ? errSSLWouldBlock : errSSLClosedAbort;
+    }
+    *len = (size_t)r;
+    if (!r) return errSSLClosedGraceful;       // the peer closed; TLS says so in its own words
+    return noErr;
+}
+
+static OSStatus dm_ssl_io_write(SSLConnectionRef ref, const void *data, size_t *len) {
+    dm_ssl_conn *c = (dm_ssl_conn *)ref;
+    long r = dm_sk_sendto(c->fd, data, *len, 0, NULL, 0);
+    if (r < 0) {
+        *len = 0;
+        return c->io_mode ? errSSLWouldBlock : errSSLClosedAbort;
+    }
+    *len = (size_t)r;
+    return noErr;
+}
+
+static dm_ssl_conn *dm_ssl_connection(void *self) {
+    return self ? (dm_ssl_conn *)objmap_get(self) : NULL;
+}
+
+static int dm_ssl_open(dm_ssl_conn *c) {
+    if (c->st) return 0;
+    if (c->fd < 0) return -1;
+    c->st = SSLCreateContext(NULL, kSSLClientSide, kSSLStreamType);   // the iOS SDK has no SSLNewContext
+    if (!c->st) return -1;
+    SSLSetIOFuncs(c->st, dm_ssl_io_read, dm_ssl_io_write);
+    SSLSetConnection(c->st, c);
+    if (c->host[0]) SSLSetPeerDomainName(c->st, c->host, strlen(c->host));
+    // iOS has no "verify on/off" switch: verification is the default, and asking for none means
+    // breaking the handshake after the server's certificate so the host can carry on regardless.
+    if (!c->verify) SSLSetSessionOption(c->st, kSSLSessionOptionBreakOnServerAuth, true);
+    return 0;
+}
+
+// 0 done, 1 wants another call (non-blocking), -1 failed.
+static int dm_ssl_handshake(dm_ssl_conn *c) {
+    if (c->handshaked) return 0;
+    if (dm_ssl_open(c)) return -1;
+    OSStatus r = SSLHandshake(c->st);
+    while (r == errSSLServerAuthCompleted) r = SSLHandshake(c->st);   // no verification asked for
+    if (r == noErr) {
+        c->handshaked = 1;
+        return 0;
+    }
+    c->last_error = (int)r;
+    return r == errSSLWouldBlock ? 1 : -1;
+}
+
+// ---------------------------------------------------------------- contexts
+
+void dm_ssl_context_create(void *self) {
+    dm_ssl_ctx *c = calloc(1, sizeof *c);
+    if (!c) die("ssl: no memory for a context");
+    c->id = (uint64_t)(uintptr_t)self;
+    objmap_put(self, c);
+}
+
+void dm_ssl_context_destroy(void *self) {
+    dm_ssl_ctx *c = self ? objmap_del(self) : NULL;
+    free(c);
+}
+
+int dm_ssl_context_import_pki(void *self, uint64_t *id) {
+    // A CA the game brought itself: SecureTransport verifies against the system roots, and Nextendo's
+    // servers chain to a public CA, so the import is remembered but not needed. Reporting success
+    // keeps a game that imports its own bundle on the normal path.
+    if (id) *id = 1;
+    (void)self;
+    return 0;
+}
+
+// ---------------------------------------------------------------- connections
+
+void dm_ssl_connection_create(void *self, void *ctx) {
+    dm_ssl_conn *c = calloc(1, sizeof *c);
+    if (!c) die("ssl: no memory for a connection");
+    c->fd = -1;
+    objmap_put(self, c);
+    (void)ctx;
+}
+
+void dm_ssl_connection_destroy(void *self) {
+    dm_ssl_conn *c = self ? objmap_del(self) : NULL;
+    if (!c) return;
+    if (c->st) CFRelease(c->st);   // the iOS SDK has no SSLDisposeContext
+    free(c);
+}
+
+int dm_ssl_set_socket(void *self, int fd) {
+    dm_ssl_conn *c = dm_ssl_connection(self);
+    if (!c) return -1;
+    c->fd = fd;
+    return 0;
+}
+
+int dm_ssl_set_host(void *self, const char *host, unsigned n) {
+    dm_ssl_conn *c = dm_ssl_connection(self);
+    if (!c || !host) return -1;
+    if (n >= sizeof c->host) n = (unsigned)sizeof c->host - 1;
+    memcpy(c->host, host, n);
+    c->host[n] = 0;
+    return 0;
+}
+
+int dm_ssl_set_io_mode(void *self, int mode) {
+    dm_ssl_conn *c = dm_ssl_connection(self);
+    if (!c) return -1;
+    c->io_mode = mode != 0;
+    return 0;
+}
+
+int dm_ssl_set_verify(void *self, int option) {
+    dm_ssl_conn *c = dm_ssl_connection(self);
+    if (!c) return -1;
+    c->verify = option;
+    return 0;
+}
+
+int dm_ssl_handshake_call(void *self) {
+    dm_ssl_conn *c = dm_ssl_connection(self);
+    if (!c) return -1;
+    return dm_ssl_handshake(c);
+}
+
+int dm_ssl_read_call(void *self, char *buf, unsigned n) {
+    dm_ssl_conn *c = dm_ssl_connection(self);
+    if (!c || !buf) return -1;
+    if (!c->handshaked) {
+        int h = dm_ssl_handshake(c);
+        if (h != 0) return h > 0 ? 0 : -1;
+    }
+    size_t got = 0;
+    OSStatus r = SSLRead(c->st, buf, n, &got);
+    if (got) return (int)got;
+    if (r == errSSLWouldBlock) return 0;
+    c->last_error = (int)r;
+    return -1;
+}
+
+int dm_ssl_write_call(void *self, const char *buf, unsigned n) {
+    dm_ssl_conn *c = dm_ssl_connection(self);
+    if (!c || !buf) return -1;
+    if (!c->handshaked) {
+        int h = dm_ssl_handshake(c);
+        if (h != 0) return h > 0 ? 0 : -1;
+    }
+    size_t put = 0;
+    OSStatus r = SSLWrite(c->st, buf, n, &put);
+    if (put) return (int)put;
+    if (r == errSSLWouldBlock) return 0;
+    c->last_error = (int)r;
+    return -1;
+}
+
+int dm_ssl_pending_call(void *self) {
+    dm_ssl_conn *c = dm_ssl_connection(self);
+    if (!c || !c->st) return 0;
+    size_t buffered = 0;
+    if (SSLGetBufferedReadSize(c->st, &buffered) != noErr) return 0;
+    return (int)buffered;
+}
+
+int dm_ssl_last_error(void *self) {
+    dm_ssl_conn *c = dm_ssl_connection(self);
+    return c ? c->last_error : 0;
