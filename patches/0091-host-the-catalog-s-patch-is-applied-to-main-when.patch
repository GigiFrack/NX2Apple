diff --git a/dm/host/tests/t_npln_patch.c b/dm/host/tests/t_npln_patch.c
new file mode 100644
index 0000000..65e331b
--- /dev/null
+++ b/dm/host/tests/t_npln_patch.c
@@ -0,0 +1,47 @@
+// The guard is the safety: a patch is written only where the build's own bytes prove it belongs.
+#include "dm.h"
+#include <stdio.h>
+#include <string.h>
+
+module_t *g_mod;
+int g_nmod;
+
+#include "../hle_npln.c"
+
+static uint8_t g_image[0x400];
+static module_t g_main;
+
+static int fail(const char *what) { fprintf(stderr, "FAIL: %s\n", what); return 1; }
+
+int main(void) {
+    // The catalog's own bytes for mpj-230-certificate, at an offset this image can hold.
+    const uint64_t off = 0x0080;
+    memset(g_image, 0, sizeof g_image);
+    g_image[off] = 0xAA; g_image[off + 1] = 0xE2; g_image[off + 2] = 0x40; g_image[off + 3] = 0x39;
+
+    const char *path = "build/t_npln.tsv";
+    FILE *f = fopen(path, "w");
+    fprintf(f, "V\t0100965017338000\t2.3.0\tnpln\t1\n");
+    fprintf(f, "P\t0100965017338000\t2.3.0\tD70CE1726C979E45ED4200E9C2B23B2A258FDC18000000000000000000000000"
+               "\tmain\t128\tAAE24039\t2A008052\n");
+    fclose(f);
+
+    memset(&g_main, 0, sizeof g_main);
+    snprintf(g_main.name, sizeof g_main.name, "main");
+    g_main.base = g_image;
+    g_main.image_size = sizeof g_image;
+    snprintf(g_main.build_id, sizeof g_main.build_id, "D70CE1726C979E45ED4200E9C2B23B2A");
+    g_mod = &g_main; g_nmod = 1;
+
+    if (dm_npln_apply_file(path, 0x0100965017338000ULL) != 1) return fail("1 guard written");
+    if (memcmp(g_image + off, "\x2A\x00\x80\x52", 4)) return fail("patched bytes");
+
+    // Another build: same offset, different guard, nothing may be written.
+    g_image[off] = 0xAA; g_image[off + 1] = 0xE2; g_image[off + 2] = 0x40; g_image[off + 3] = 0x39;
+    snprintf(g_main.build_id, sizeof g_main.build_id, "37C6625DD50F7C9D0000000000000000");
+    if (dm_npln_apply(0x0100965017338000ULL) != 0) return fail("a different build is refused");
+    if (memcmp(g_image + off, "\xAA\xE2\x40\x39", 4)) return fail("a refused patch writes nothing");
+
+    printf("ok t_npln_patch\n");
+    return 0;
+}
