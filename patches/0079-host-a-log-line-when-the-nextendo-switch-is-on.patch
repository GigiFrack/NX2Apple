From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes <hermes@local>
Date: Wed, 18 Nov 2026 12:35:18 +0000
Subject: [PATCH] host: a log line when the Nextendo switch is on
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The switch changes behaviour only where a name resolves or an account is asked for, so a log could
not tell "on and nothing asked" from "never seen" — the two states have different fixes. One line at
startup, with the rule count and the two settings that matter, ends that ambiguity.

Upstream-Status: fork-only
Reason: part of the DM_NEXTENDO seam: without a startup line, a log cannot tell "the switch is on and nothing asked for a name" from "the switch never arrived", and those have different fixes
Issue: none opened yet — folds into the same PR as 0063-0073

---
 dm/host/main.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/dm/host/main.c b/dm/host/main.c
index 8c7eccd..51e2d2d 100644
--- a/dm/host/main.c
+++ b/dm/host/main.c
@@ -1,6 +1,7 @@
 // Bootstrap: after loading the modules, initialize the SDK runtime in the real order of nn::init::Start (sdk+0x2b0470) in the SDK, then enter nnMain.
 #include "dm.h"
 #include "front.h"
+#include "hle_nextendo.h"
 #include "../gfx/nvn/dmsh_chain.h"
 #include <CoreFoundation/CoreFoundation.h>
 #include <stdatomic.h>
@@ -117,6 +118,12 @@ static void host_preload(int argc, char **argv) {
         CFBundleRef b = CFBundleGetMainBundle(); CFTypeRef c = b ? CFBundleGetValueForInfoDictionaryKey(b, CFSTR("DMCommit")) : NULL; char cs[64] = "not recorded";
         if (c && CFGetTypeID(c) == CFStringGetTypeID()) CFStringGetCString((CFStringRef)c, cs, sizeof cs, kCFStringEncodingUTF8);
         LOG("build: commit %s, shader chain %s, profile %s", cs, DMSH_CHAIN, dm_profile()->id);
+        if (dm_nd_enabled()) {   // the switch arrived: say so once, so a log can tell "on" from "never seen"
+            dm_nd_reload();
+            const char *dom = getenv("DM_NEXTENDO_DOMAIN"), *app = getenv("DM_NEXTENDO_APP_ID");
+            LOG("nextendo: on, %d host rule(s), domain %s, app %s", dm_nd_rule_count(),
+                dom && *dom ? dom : "(none)", app && *app ? app : "(none)");
+        }
         if (getenv("DM_PROFILE")) dm_profile_log();   // a runtime profile: say what it holds
     }
     const char *race = getenv("DM_TEST_KEYRACE");
