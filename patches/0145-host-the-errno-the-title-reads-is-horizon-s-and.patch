+// The number the title reads back. Horizon's socket errors are the Linux ones (Ryujinx Nextendo,
+// LinuxError.cs: EAGAIN 11, EINPROGRESS 115, ECONNRESET 104, ENOTCONN 107, ENETDOWN 100), while this host
+// numbers them as Darwin does (EAGAIN 35, EINPROGRESS 36). A title that compares the number with its own
+// EAGAIN reads the host's 35 as an error it does not know, so a non-blocking read that found nothing yet
+// becomes a hard failure in its TLS stack. The value leaves only through nd_hz_errno.
+static int nd_hz_errno(int e) {
+    switch (e) {
+    case 35: return 11;     // EAGAIN / EWOULDBLOCK
+    case 36: return 115;    // EINPROGRESS
+    case 37: return 114;    // EALREADY
+    default: return e >= 38 && e <= 63 ? e + 50 : e;   // one family: Darwin 38..63 is Horizon 88..113
+    }
+}
+// The reverse, for the errors a title sets itself (SetLastErrno).
+static int nd_hz_errno_in(int e) {
+    switch (e) {
+    case 11: return 35;
+    case 115: return 36;
+    case 114: return 37;
+    default: return e >= 88 && e <= 113 ? e - 50 : e;
+    }
+}
+// A C entry is not the C++ one. The titles reach these through their own C library (the SDK's nnmusl),
+// whose layer takes a syscall's answer as -errno and turns it into errno = -r. Answering -1 there makes the
+// title read errno 1 (EPERM) whatever went wrong: a read that merely found nothing yet, an address family
+// this host does not serve, all of it the same "permission denied" to the caller.
+static int sk_guest(int r) { return r >= 0 ? r : -nd_hz_errno(t_skerr); }
+static int sk_guest_fail(int host_errno) { sk_error(host_errno); return -nd_hz_errno(t_skerr); }
+// A stream socket's close is traced: a client that gives up on a connection closes it, and in a log where the
+// close is silent that reads exactly like a connection the server dropped.
+static int sk_close(int s) {
+    int r = dm_sk_close(s);
+    if (nd_tcp_range(s)) { char t[64]; snprintf(t, sizeof t, "socket::Close(fd %d)", s); dm_nd_trace_result(t, r); }
+    return r;
+}
 static int nd_addr_read(const void *a, unsigned n, uint32_t *addr, uint16_t *port) {
