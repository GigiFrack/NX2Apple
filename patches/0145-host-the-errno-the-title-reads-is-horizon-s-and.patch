     if (hp.revents & POLLOUT) rev |= events & (SK_POLLOUT | SK_POLLWRNORM);
+    // A closed peer is reported whatever the caller asked for, as poll(2) says: the HTTP/2 transport of the
+    // NPLN client polls with events 0 after its write, and an answer with no hang-up is an answer that
+    // leaves it waiting for a reply that will never come.
+    if (hp.revents & (POLLHUP | POLLERR)) rev |= SK_POLLHUP;
