+                            what, fd, iov, dm_sk_errno(), nd_hz_errno(dm_sk_errno()), nd_tcp_ready(fd, SK_POLLIN) != 0);
     else snprintf(t, sizeof t, "socket::%s(fd %d, %u iovec)", what, fd, iov);
