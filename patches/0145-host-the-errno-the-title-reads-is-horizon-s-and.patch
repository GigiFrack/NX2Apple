+        if (nd_hz_errno(ND_EINPROGRESS) != 115) fail("EINPROGRESS in the title's numbering");
+        if (nd_hz_errno(54) != 104) fail("ECONNRESET in the title's numbering");
+        if (nd_hz_errno(ND_ETIMEDOUT) != 110) fail("ETIMEDOUT in the title's numbering");
+        if (nd_hz_errno(SK_ENOTCONN) != 107) fail("ENOTCONN in the title's numbering");
+        if (nd_hz_errno(SK_ENETDOWN) != 100) fail("ENETDOWN in the title's numbering");
+        if (nd_hz_errno(SK_EBADF) != 9 || nd_hz_errno(SK_EINVAL) != 22) fail("a number both ABIs share");
