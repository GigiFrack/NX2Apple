From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes <hermes@local>
Date: Thu, 19 Nov 2026 14:02:25 +0000
Subject: [PATCH] tools: one main(), the one that knows --apply

Upstream-Status: fork-only
Reason: The apply mode was spliced in above the original main(), so the module carried two definitions of main and Python
 used the last one: --apply was read as the output file name and a file called --apply was written. There is one
 main() now, which answers --apply first and generates the TSV otherwise.
Issue: https://github.com/GigiFrack/NX2Apple (fork)

---
 dm/tools/npln_catalog.py | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/dm/tools/npln_catalog.py b/dm/tools/npln_catalog.py
index d316825..6b58824 100644
--- a/dm/tools/npln_catalog.py
+++ b/dm/tools/npln_catalog.py
@@ -130,7 +130,7 @@ def main() -> int:
     argv = sys.argv[1:]
     if argv[:1] == ["--apply"]:
         if len(argv) < 3 or "--title" not in argv:
-            print("usage: npln_catalog.py --apply <main NSO> --title <16 hex digits>")
+            print("usage: npln_catalog.py --apply <main NSO or game folder> --title <16 hex digits>")
             return 2
         path = argv[1]
         title = argv[argv.index("--title") + 1]
@@ -139,8 +139,6 @@ def main() -> int:
         print("%s: %d patch(es) written" % (path, n))
         return 0 if n else 1
 
-
-def main() -> int:
     out = sys.argv[1] if len(sys.argv) > 1 else "npln_patches.tsv"
     games = json.loads(verify(fetch("game-catalog"), "catalog-key-1"))
     patches = json.loads(verify(fetch("npln-patches"), "npln-patches-key-1"))
