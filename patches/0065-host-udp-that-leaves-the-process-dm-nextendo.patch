From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes <hermes@local>
Date: Wed, 18 Nov 2026 02:08:01 +0000
Subject: [PATCH] host: UDP that leaves the process (DM_NEXTENDO)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The datagram path was the whole network: a destination with no local socket on that port was
dropped, and every address had to be 127.x. PRUDP is the opposite — the secure server and the
NAT check are UDP to a remote host — so with the switch on, a datagram with no local
destination goes out a host socket, bound to the port the guest bound so the answer lands on
the same descriptor, and recvfrom reads it back. With the switch off nothing changes: a public
address is still refused, the local queue is still the network.

t_net_udp_remote echoes one datagram through a real listener, then checks the switch-off
refusal.

Upstream-Status: fork-only
Reason: upstream's datagram path never leaves the process by design (offline games only); a Nextendo client needs UDP to the secure server and the NAT check, and the fork keeps it behind DM_NEXTENDO
Issue: none opened yet — notes/nextendo-spike.md carries the plan and the open question for Nextendo

---
 dm/host/hle_net.c                |  67 ++++++++++++++++++++-
 dm/host/tests/Makefile           |   3 +
 dm/host/tests/t_net_udp_remote.c | 100 +++++++++++++++++++++++++++++++
 3 files changed, 167 insertions(+), 3 deletions(-)
 create mode 100644 dm/host/tests/t_net_udp_remote.c

diff --git a/dm/host/hle_net.c b/dm/host/hle_net.c
index 20807fb..ef53a8e 100644
--- a/dm/host/hle_net.c
+++ b/dm/host/hle_net.c
@@ -355,6 +355,7 @@ static struct {
     uint32_t addr, peer_addr; uint16_t port, peer_port;
     int connected, shut_read, shut_write, reuse, broadcast, rcvbuf, sndbuf;
     int64_t recv_timeout, send_timeout; sk_packet *head, *tail; size_t queued; unsigned packets;
+    int host_udp;   // the descriptor that puts a datagram on the wire; -1 until one is needed
 } g_efd[EFD_MAX];
 static uint64_t g_sk_generation;
 static uint16_t g_sk_ephemeral = 49152;
@@ -365,6 +366,7 @@ static int efd_used(int fd) { return sk_used(fd) && g_efd[fd].used == SK_EFD; }
 static int sk_new_locked(int kind) {
     for (int i = 0; i < EFD_MAX; i++) if (!g_efd[i].used) {
         memset(&g_efd[i], 0, sizeof g_efd[i]); g_efd[i].used = kind; g_efd[i].generation = ++g_sk_generation;
+        g_efd[i].host_udp = -1;
         g_efd[i].rcvbuf = g_efd[i].sndbuf = SK_DEFAULT_BUF; return i;
     }
     return sk_error(24);   // EMFILE
@@ -388,6 +390,7 @@ int dm_sk_close(int fd) {
     if (!sk_used(fd)) { pthread_mutex_unlock(&g_efd_m); return sk_fail(); }
     sk_packet *p = g_efd[fd].head;
     while (p) { sk_packet *next = p->next; free(p); p = next; }
+    if (g_efd[fd].host_udp >= 0) { close(g_efd[fd].host_udp); g_efd[fd].host_udp = -1; }
     g_efd[fd].head = g_efd[fd].tail = NULL; g_efd[fd].used = 0; pthread_cond_broadcast(&g_efd_c);
     pthread_mutex_unlock(&g_efd_m); return 0;
 }
@@ -423,7 +426,7 @@ static int sk_addr_read(const void *a, unsigned n, uint32_t *addr, uint16_t *por
     if (b[1] != 2 || (b[0] && b[0] != 16)) return sk_error(SK_EINVAL);
     *port = (uint16_t)((unsigned)b[2] << 8 | b[3]);
     *addr = (uint32_t)b[4] << 24 | (uint32_t)b[5] << 16 | (uint32_t)b[6] << 8 | b[7];
-    if (*addr && (*addr >> 24) != 127) return sk_fail();
+    if (*addr && (*addr >> 24) != 127 && !dm_nd_enabled()) return sk_fail();
     return 0;
 }
 static int sk_addr_write(void *a, unsigned *n, uint32_t addr, uint16_t port) {
@@ -543,6 +546,51 @@ int dm_sk_getopt(int fd, int level, int option, void *value, unsigned *size) {
     }
     pthread_mutex_unlock(&g_efd_m); return r;
 }
+// ---------------------------------------------------------------- Nextendo: UDP that leaves the process
+// The datagram path delivers inside this process and nothing else: the queue above is the network.
+// PRUDP is the opposite — the secure server and the NAT check are UDP to a remote host — so with
+// DM_NEXTENDO on, a datagram with no local destination goes out a host socket, bound to the port the
+// guest bound (so replies land on the same descriptor) and read back by the same recvfrom.
+
+static int nd_udp_host(int fd) {   // with g_efd_m held
+    if (g_efd[fd].host_udp >= 0) return g_efd[fd].host_udp;
+    if (!dm_nd_enabled()) return -1;
+    int h = socket(AF_INET, SOCK_DGRAM, 0);
+    if (h < 0) return -1;
+    if (g_efd[fd].port) {
+        struct sockaddr_in a = {0};
+        int one = 1;
+        a.sin_family = AF_INET;
+        a.sin_addr.s_addr = htonl(INADDR_ANY);
+        a.sin_port = htons(g_efd[fd].port);
+        setsockopt(h, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+        if (bind(h, (struct sockaddr *)&a, sizeof a) < 0) { close(h); return -1; }
+    }
+    g_efd[fd].host_udp = h;
+    return h;
+}
+
+// Is there a datagram waiting on the wire? Asked by the poll path, which must not consume it.
+static int nd_udp_ready(int fd) {   // with g_efd_m held
+    int h = g_efd[fd].host_udp;
+    if (h < 0) return 0;
+    struct pollfd hp = {h, POLLIN, 0};
+    return poll(&hp, 1, 0) > 0 && (hp.revents & (POLLIN | POLLERR)) != 0;
+}
+
+// A datagram from the wire, or -2 when there is none (the caller then keeps waiting on the queue).
+static long nd_udp_read(int fd, void *data, unsigned long n, int flags, void *a, unsigned *al) {   // with g_efd_m held
+    int h = g_efd[fd].host_udp;
+    if (h < 0) return -2;
+    struct sockaddr_in sa;
+    socklen_t sl = sizeof sa;
+    ssize_t r = recvfrom(h, data, n, (flags & SK_MSG_PEEK ? MSG_PEEK : 0) | MSG_DONTWAIT,
+                         (struct sockaddr *)&sa, &sl);
+    if (r < 0) return -2;
+    nd_addr_write(a, al, ntohl(sa.sin_addr.s_addr), ntohs(sa.sin_port));
+    return (long)r;
+}
+
 long dm_sk_sendto(int fd, const void *data, unsigned long n, int flags, const void *a, unsigned al) {
     long tcp = dm_nd_tcp_send(fd, data, n, flags);
     if (tcp != ND_NOT) return tcp;
@@ -572,6 +620,15 @@ long dm_sk_sendto(int fd, const void *data, unsigned long n, int flags, const vo
             if (g_efd[i].tail) g_efd[i].tail->next = p; else g_efd[i].head = p;
             g_efd[i].tail = p; g_efd[i].queued += n; g_efd[i].packets++; pthread_cond_broadcast(&g_efd_c);
         }
+    } else {
+        int h = nd_udp_host(fd);
+        if (h >= 0) {
+            struct sockaddr_in sa = {0};
+            sa.sin_family = AF_INET;
+            sa.sin_port = htons(port);
+            sa.sin_addr.s_addr = htonl(addr);
+            if (sendto(h, data, n, 0, (struct sockaddr *)&sa, sizeof sa) < 0) { t_skerr = SK_ENETDOWN; goto done; }
+        }
     }
     r = (long)n;
 done:
@@ -605,11 +662,13 @@ long dm_sk_recvfrom(int fd, void *data, unsigned long n, int flags, void *a, uns
             if (!(flags & SK_MSG_PEEK)) { g_efd[fd].head = p->next; if (!p->next) g_efd[fd].tail = NULL; g_efd[fd].queued -= p->size; g_efd[fd].packets--; free(p); }
             break;
         }
+        long wire = nd_udp_read(fd, data, n, flags, a, al);
+        if (wire != -2) { r = wire; break; }
         if (g_efd[fd].shut_read) { r = 0; break; }
         if (flags & SK_MSG_DONTWAIT || g_efd[fd].flags & SK_NONBLOCK) { t_skerr = SK_EAGAIN; break; }
         int64_t left = g_efd[fd].recv_timeout ? g_efd[fd].recv_timeout - (int64_t)(guest_ns() - start) : 100000000;
         if (left <= 0) { t_skerr = SK_EAGAIN; break; }
-        if (dm_detclock_enabled() && left > 1000000) left = 1000000;
+        if ((dm_detclock_enabled() || g_efd[fd].host_udp >= 0) && left > 1000000) left = 1000000;
         dm_guest_cond_wait_ns(&g_efd_c, &g_efd_m, left);
     }
 done:
@@ -622,7 +681,9 @@ static int efd_ready(sk_pollfd *p, uint64_t n, uint64_t open, const uint64_t gen
         p[i].revents = 0; int fd = p[i].fd;
         if (fd < 0 || fd >= EFD_MAX || !(open >> fd & 1)) continue;
         if (!sk_used(fd) || g_efd[fd].generation != generation[fd]) { p[i].revents = SK_POLLNVAL; ready++; continue; }
-        if (g_efd[fd].used == SK_EFD ? g_efd[fd].count != 0 : (g_efd[fd].head != NULL || g_efd[fd].shut_read)) p[i].revents |= p[i].events & (SK_POLLIN | SK_POLLRDNORM);
+        if (g_efd[fd].used == SK_EFD ? g_efd[fd].count != 0
+                                     : (g_efd[fd].head != NULL || g_efd[fd].shut_read || nd_udp_ready(fd)))
+            p[i].revents |= p[i].events & (SK_POLLIN | SK_POLLRDNORM);
         if (g_efd[fd].used == SK_EFD || !g_efd[fd].shut_write) p[i].revents |= p[i].events & (SK_POLLOUT | SK_POLLWRNORM);
         if (p[i].revents) ready++;
     }
