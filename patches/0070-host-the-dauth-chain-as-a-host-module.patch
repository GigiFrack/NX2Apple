diff --git a/dm/host/hle_dauth.c b/dm/host/hle_dauth.c
new file mode 100644
index 0000000..ad15896
--- /dev/null
+++ b/dm/host/hle_dauth.c
@@ -0,0 +1,213 @@
+// The device/application authentication chain, as a host module.
+//
+// On a console the game asks the dauth system module for a token and the module speaks HTTP to five
+// hosts. There is no system module here, so this is the piece that does the speaking: challenge,
+// device tokens, edge tokens, application auth token — the same four calls nx-dauth serves, in the
+// same order, over the TLS stack hle_ssl.c already uses.
+//
+// What it does not do: verify the JWTs the servers sign (dcert/acert publish the keys for that, and
+// the game is the party that checks them), and the dragons/licence calls that follow aauth.
+//
+// Everything needs DM_NEXTENDO=1, and the domain comes from DM_NEXTENDO_DOMAIN so no hostname of a
+// particular service is baked into the source.
+#include "hle.h"
+#include "hle_dauth.h"
+#include "hle_nextendo.h"
+
+#include <Security/SecureTransport.h>
+#include <Security/Security.h>
+#include <netdb.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+
+#define DCHAUTH_MAX_BODY 65536
+
+static int dauth_connect(const char *host, int port) {
+    // The map the games resolve through first: with Nextendo on, dauth.<domain> is a rule there.
+    struct sockaddr_in sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sin_family = AF_INET;
+    sa.sin_port = htons((uint16_t)port);
+    uint32_t addrs[4];
+    if (dm_nd_lookup(host, addrs, 4) > 0) {
+        sa.sin_addr.s_addr = htonl(addrs[0]);      // the map keeps addresses in host order
+    } else {
+        struct addrinfo hints, *res = NULL;
+        memset(&hints, 0, sizeof hints);
+        hints.ai_family = AF_INET;
+        hints.ai_socktype = SOCK_STREAM;
+        char p[8];
+        snprintf(p, sizeof p, "%d", port);
+        if (getaddrinfo(host, p, &hints, &res) != 0 || !res) return -1;
+        memcpy(&sa, res->ai_addr, sizeof sa);
+        freeaddrinfo(res);
+    }
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) return -1;
+    struct timeval tv = {10, 0};
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);
+    if (connect(fd, (struct sockaddr *)&sa, sizeof sa)) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+typedef struct { int fd; } http_conn;
+
+static OSStatus http_read(SSLConnectionRef ref, void *data, size_t *len) {
+    http_conn *c = (http_conn *)ref;
+    ssize_t r = recv(c->fd, data, *len, 0);
+    if (r <= 0) { *len = 0; return r == 0 ? errSSLClosedGraceful : errSSLClosedAbort; }
+    *len = (size_t)r;
+    return noErr;
+}
+
+static OSStatus http_write(SSLConnectionRef ref, const void *data, size_t *len) {
+    http_conn *c = (http_conn *)ref;
+    ssize_t r = send(c->fd, data, *len, 0);
+    if (r < 0) { *len = 0; return errSSLClosedAbort; }
+    *len = (size_t)r;
+    return noErr;
+}
+
+// One request, one connection, Connection: close. Returns the HTTP status, or -1.
+static int http_call(const char *host, int port, const char *method, const char *path,
+                     const char *ctype, const char *body, char *out, size_t cap) {
+    int fd = dauth_connect(host, port);
+    if (fd < 0) return -1;
+    http_conn hc = {fd};
+    SSLContextRef st = SSLCreateContext(NULL, kSSLClientSide, kSSLStreamType);
+    if (!st) { close(fd); return -1; }
+    SSLSetIOFuncs(st, http_read, http_write);
+    SSLSetConnection(st, &hc);
+    SSLSetPeerDomainName(st, host, strlen(host));
+    SSLSetSessionOption(st, kSSLSessionOptionBreakOnServerAuth, getenv("DM_NEXTENDO_TLS_INSECURE") != NULL);
+    OSStatus hs = SSLHandshake(st);
+    while (hs == errSSLServerAuthCompleted) hs = SSLHandshake(st);   // only with TLS_INSECURE
+    if (hs != noErr) {
+        CFRelease(st);
+        close(fd);
+        return -1;
+    }
+
+    char req[1024];
+    int n = snprintf(req, sizeof req,
+                     "%s %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: NX2Apple\r\nAccept: */*\r\n"
+                     "Connection: close\r\nContent-Type: %s\r\nContent-Length: %zu\r\n\r\n",
+                     method, path, host, ctype ? ctype : "application/json",
+                     body ? strlen(body) : 0);
+    size_t put = 0;
+    SSLWrite(st, req, (size_t)n, &put);
+    if (body) SSLWrite(st, body, strlen(body), &put);
+
+    char *buf = malloc(DCHAUTH_MAX_BODY);
+    size_t got = 0, rd = 0;
+    if (buf) {
+        while (got < DCHAUTH_MAX_BODY - 1) {
+            OSStatus r = SSLRead(st, buf + got, DCHAUTH_MAX_BODY - 1 - got, &rd);
+            got += rd;
+            if (r != noErr && r != errSSLWouldBlock) break;
+            if (!rd) break;
+        }
+        buf[got] = 0;
+    }
+    CFRelease(st);
+    close(fd);
+
+    int status = -1;
+    if (buf) {
+        if (!strncmp(buf, "HTTP/1.", 7)) status = atoi(buf + 9);
+        char *sep = strstr(buf, "\r\n\r\n");
+        if (out && cap) {
+            out[0] = 0;
+            if (sep) {
+                size_t len = strlen(sep + 4);
+                if (len >= cap) len = cap - 1;
+                memcpy(out, sep + 4, len);
+                out[len] = 0;
+            }
+        }
+        free(buf);
+    }
+    return status;
+}
+
+// The first string value of a key, unescaped only as far as tokens need (no \u sequences in them).
+static int json_string(const char *json, const char *key, char *out, size_t cap) {
+    char pat[64];
+    snprintf(pat, sizeof pat, "\"%s\":\"", key);
+    const char *p = strstr(json, pat);
+    if (!p) return 0;
+    p += strlen(pat);
+    size_t i = 0;
+    while (*p && *p != '"' && i + 1 < cap) out[i++] = *p++;
+    out[i] = 0;
+    return 1;
+}
+
+// 443 on a console; a local shim of the stack (nx-dauth in Docker) listens elsewhere.
+static int dauth_port(void) {
+    const char *p = getenv("DM_NEXTENDO_HTTPS_PORT");
+    return p && *p ? atoi(p) : 443;
+}
+
+static const char *dauth_domain(void) {
+    const char *d = getenv("DM_NEXTENDO_DOMAIN");
+    return d && *d ? d : NULL;
+}
+
+static const char *dauth_device_id(void) {
+    const char *d = getenv("DM_NEXTENDO_DEVICE_ID");
+    return d && *d ? d : "0123456789abcdef0123456789abcdef";
+}
+
+int dm_dauth_application_token(const char *app_id, const char *app_version, char *out, size_t cap) {
+    const char *domain = dauth_domain();
+    if (!dm_nd_enabled() || !domain || !app_id) return -1;
+    if (out && cap) out[0] = 0;
+
+    char host[256], body[512], resp[DCHAUTH_MAX_BODY];
+    snprintf(host, sizeof host, "dauth.%s", domain);
+
+    // 1. the challenge: the console would sign it, the self-hosted chain answers one it does not check
+    if (http_call(host, dauth_port(), "POST", "/v8/challenge", "application/json", "{}", resp, sizeof resp) != 200)
+        return -1;
+    char challenge[128] = {0};
+    json_string(resp, "challenge", challenge, sizeof challenge);
+
+    // 2. the device token, per client
+    snprintf(body, sizeof body, "{\"token_requests\":[{\"client_id\":\"%s\"}]}", dauth_device_id());
+    if (http_call(host, dauth_port(), "POST", "/v8/device_auth_tokens", "application/json", body, resp, sizeof resp) != 200)
+        return -1;
+    char device_token[1024] = {0};
+    if (!json_string(resp, "device_auth_token", device_token, sizeof device_token)) return -1;
+
+    // 3. the edge token, which is what the application auth call is made with
+    snprintf(body, sizeof body, "{\"token_requests\":[{\"client_id\":\"%s\",\"vendor_id\":\"0\"}]}",
+             dauth_device_id());
+    if (http_call(host, dauth_port(), "POST", "/v8/edge_tokens", "application/json", body, resp, sizeof resp) != 200)
+        return -1;
+    char edge[1024] = {0};
+    json_string(resp, "dtoken", edge, sizeof edge);
+
+    // 4. the application auth token: form-encoded, and the answer is the one the game wants
+    snprintf(host, sizeof host, "aauth.%s", domain);
+    snprintf(body, sizeof body, "application_id=%s&application_version=%s", app_id,
+             app_version ? app_version : "0");
+    if (http_call(host, dauth_port(), "POST", "/v5/application_auth_token",
+                  "application/x-www-form-urlencoded", body, resp, sizeof resp) != 200)
+        return -1;
+    if (!json_string(resp, "application_auth_token", out, cap)) return -1;
+    (void)challenge;
+    (void)device_token;
+    (void)edge;
+    return 0;
+}
diff --git a/dm/host/hle_dauth.h b/dm/host/hle_dauth.h
new file mode 100644
index 0000000..a0d8aef
--- /dev/null
+++ b/dm/host/hle_dauth.h
@@ -0,0 +1,8 @@
+// The dauth chain as the host speaks it: the four calls a token needs, against the mock server the
+// fork's workflow starts on 127.0.0.1 (a self-signed certificate, so TLS_INSECURE for the test).
+#pragma once
+
+#include <stddef.h>
+
+// 0 on success; writes the application auth token into out.
+int dm_dauth_application_token(const char *app_id, const char *app_version, char *out, size_t cap);
