 $(B)/t_ssl_local: t_ssl_local.c ../hle_net.c ../hle_ssl.c ../hle_ssl.h ../hle_nextendo.c ../hle_nextendo.h ../hle.h ../dm.h $(GAME_H) | $(B)
 	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_ssl_local.c -framework Security -framework CoreFoundation
 # The Nextendo hostname map and resolver are plain C with no game profile: these tests build without GAME.
diff --git a/dm/host/tests/t_dauth_local.c b/dm/host/tests/t_dauth_local.c
new file mode 100644
index 0000000..7660290
--- /dev/null
+++ b/dm/host/tests/t_dauth_local.c
@@ -0,0 +1,37 @@
+// The dauth chain, end to end, against the mock the workflow starts: four calls in order, and the
+// application auth token comes back. Then the same call with the switch off, which must refuse.
+#include "../hle_nextendo.c"
+#include "../hle_dauth.c"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static void fail(const char *what) {
+    fprintf(stderr, "not true: %s\n", what);
+    exit(1);
+}
+
+int main(void) {
+    const char *port = getenv("DM_TEST_DAUTH_PORT");
+    if (!port) { fprintf(stderr, "DM_TEST_DAUTH_PORT is not set\n"); return 1; }
+
+    setenv("DM_NEXTENDO", "1", 1);
+    setenv("DM_NEXTENDO_DOMAIN", "local", 1);
+    setenv("DM_NEXTENDO_HTTPS_PORT", port, 1);
+    setenv("DM_NEXTENDO_TLS_INSECURE", "1", 1);
+    setenv("DM_NEXTENDO_HOSTS", "dauth.local=127.0.0.1,aauth.local=127.0.0.1", 1);
+    dm_nd_reload();
+
+    char token[256] = {0};
+    if (dm_dauth_application_token("0100152000022000", "0", token, sizeof token)) fail("the chain returned a token");
+    if (strcmp(token, "APP-TOKEN-42")) fail("the token is the server's");
+
+    unsetenv("DM_NEXTENDO");
+    dm_nd_reload();
+    char refused[256] = {0};
+    if (!dm_dauth_application_token("0100152000022000", "0", refused, sizeof refused)) fail("the switch off refuses");
+
+    puts("ok");
+    return 0;
+}
