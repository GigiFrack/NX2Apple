diff --git a/dm/host/tests/t_nextendo_gai.c b/dm/host/tests/t_nextendo_gai.c
new file mode 100644
index 0000000..05d8259
--- /dev/null
+++ b/dm/host/tests/t_nextendo_gai.c
@@ -0,0 +1,73 @@
+// The resolver: the Nextendo map answers first, the real one after it, and with the switch off the
+// answer is the same EAI_FAIL an offline build has always given.
+//
+// Portable on purpose (no hle.h): this test builds and runs anywhere, and checks the structure the
+// game is handed — FreeBSD's field order, a 16-byte sockaddr_in, network byte order.
+#include "../hle_nextendo.c"
+#include "../hle_nextendo_gai.c"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static void fail(const char *what) {
+    fprintf(stderr, "not true: %s\n", what);
+    exit(1);
+}
+
+typedef struct {
+    int ai_flags, ai_family, ai_socktype, ai_protocol;
+    uint32_t ai_addrlen; char *ai_canonname; uint8_t *ai_addr; void *ai_next;
+} ai_view;
+
+int main(void) {
+    unsetenv("DM_NEXTENDO_HOSTS_FILE");
+    setenv("DM_NEXTENDO", "1", 1);
+    setenv("DM_NEXTENDO_HOSTS", "10.0.0.9 g2b309e01-lp1.srv.nintendo.net\n*.ndas.srv.nintendo.net\n", 1);
+    dm_nd_reload();
+
+    // 1. a mapped name: one address, the port the caller asked for, and the fields a game reads
+    void *res = NULL;
+    if (dm_nd_gai("g2b309e01-lp1.srv.nintendo.net", "443", NULL, &res) != 0 || !res) fail("a mapped name");
+    ai_view *ai = res;
+    if (ai->ai_family != 2) fail("family is AF_INET");
+    if (ai->ai_socktype != 1) fail("socktype defaults to stream");
+    if (ai->ai_addrlen != 16) fail("sockaddr_in is 16 bytes");
+    if (!ai->ai_addr || ai->ai_addr[0] != 16 || ai->ai_addr[1] != 2) fail("sockaddr length and family bytes");
+    if (((unsigned)ai->ai_addr[2] << 8 | ai->ai_addr[3]) != 443) fail("port, network byte order");
+    if (ai->ai_addr[4] != 10 || ai->ai_addr[5] != 0 || ai->ai_addr[6] != 0 || ai->ai_addr[7] != 9)
+        fail("the map's address");
+    if (ai->ai_next) fail("one address for one rule");
+    dm_nd_freeai(res);
+    res = NULL;
+
+    // 2. the wildcard, and the caller's own socktype
+    ai_view hints = {0};
+    hints.ai_socktype = 2;                       // SOCK_DGRAM
+    if (dm_nd_gai("aauth-lp1.ndas.srv.nintendo.net", "0", &hints, &res) != 0 || !res) fail("the wildcard");
+    ai = res;
+    if (ai->ai_socktype != 2 || ai->ai_protocol != 17) fail("a datagram hint comes back as datagram/IPPROTO_UDP");
+    dm_nd_freeai(res);
+    res = NULL;
+
+    // 3. a name nobody mapped goes to the real resolver: localhost is in every /etc/hosts
+    if (dm_nd_gai("localhost", "80", NULL, &res) != 0 || !res) fail("an unmapped name resolves for real");
+    ai = res;
+    if (ai->ai_addr[4] != 127 || ai->ai_addr[7] != 1) fail("localhost is 127.0.0.1");
+    dm_nd_freeai(res);
+    res = NULL;
+
+    // 4. a name that does not exist is EAI_NONAME, not a crash
+    if (dm_nd_gai("no-such-host.invalid", "80", NULL, &res) == 0) fail("a name that cannot resolve");
+
+    // 5. the switch off: EAI_FAIL and nothing handed back
+    unsetenv("DM_NEXTENDO");
+    dm_nd_reload();
+    res = (void *)0x1;
+    if (dm_nd_gai("g2b309e01-lp1.srv.nintendo.net", "443", NULL, &res) != 4) fail("EAI_FAIL with the switch off");
+    if (res) fail("nothing is handed back with the switch off");
+
+    dm_nd_freeai(NULL);                         // a no-op, as FreeAddrInfo(NULL) must be
+
+    puts("ok");
+    return 0;
+}
