 int dm_nd_rule_count(void);
+
+//: Resolve a name the way nn::socket::GetAddrInfo must: the map first, then the real resolver.
+//: Returns 0 and fills *res with a chain of Horizon `addrinfo` structures, or an EAI_* code.
+int dm_nd_gai(const char *node, const char *service, const void *hints, void **res);
+
+//: Free what dm_nd_gai built (NULL is a no-op).
+void dm_nd_freeai(void *ai);
diff --git a/dm/host/hle_nextendo_gai.c b/dm/host/hle_nextendo_gai.c
new file mode 100644
index 0000000..c88d9fb
--- /dev/null
+++ b/dm/host/hle_nextendo_gai.c
@@ -0,0 +1,129 @@
+// The resolver the online seams resolve through: the Nextendo map first, then the real one.
+//
+// nn::socket::GetAddrInfo hands the game Horizon's own `addrinfo` (libnx mirrors it in
+// nx/external/bsd/include/netdb.h): FreeBSD's field order, so `ai_canonname` comes before `ai_addr`
+// — the opposite of glibc — and every address is the 16-byte `sockaddr_in` with length and family
+// bytes first. The host therefore builds that structure itself instead of passing the system's on.
+//
+// No hle.h here: this unit has no HLE entry to register, so it stays plain C and is tested off
+// Darwin like hle_nextendo.c.
+#include "hle_nextendo.h"
+#include <netdb.h>
+#include <netinet/in.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+
+#define ND_AI_MAX 8
+#define ND_EAI_FAIL 4
+#define ND_EAI_NONAME 5
+#define ND_SOCK_STREAM 1
+#define ND_SOCK_DGRAM 2
+
+// Horizon's struct addrinfo: four ints, a socklen_t, then three pointers in FreeBSD's order.
+typedef struct {
+    int ai_flags;
+    int ai_family;
+    int ai_socktype;
+    int ai_protocol;
+    uint32_t ai_addrlen;
+    char *ai_canonname;
+    void *ai_addr;
+    void *ai_next;
+} nd_addrinfo;
+_Static_assert(sizeof(nd_addrinfo) == 48, "Horizon's addrinfo is 48 bytes on arm64");
+
+static uint16_t nd_service_port(const char *service) {
+    if (!service || !*service) return 0;
+    char *end = NULL;
+    unsigned long v = strtoul(service, &end, 10);
+    return end && !*end && v <= 65535 ? (uint16_t)v : 0;
+}
+
+static void *nd_ai_new(int socktype, int protocol, uint32_t addr, uint16_t port, void *next) {
+    nd_addrinfo *ai = calloc(1, sizeof *ai);
+    uint8_t *sa = calloc(1, 16);
+    if (!ai || !sa) {
+        free(ai);
+        free(sa);
+        return NULL;
+    }
+    sa[0] = 16;
+    sa[1] = 2;                                   // AF_INET
+    sa[2] = (uint8_t)(port >> 8);
+    sa[3] = (uint8_t)port;
+    sa[4] = (uint8_t)(addr >> 24);
+    sa[5] = (uint8_t)(addr >> 16);
+    sa[6] = (uint8_t)(addr >> 8);
+    sa[7] = (uint8_t)addr;
+    ai->ai_family = 2;
+    ai->ai_socktype = socktype;
+    ai->ai_protocol = protocol;
+    ai->ai_addrlen = 16;
+    ai->ai_addr = sa;
+    ai->ai_next = next;
+    return ai;
+}
+
+int dm_nd_gai(const char *node, const char *service, const void *hints, void **res) {
+    if (!res) return ND_EAI_FAIL;
+    *res = NULL;
+    if (!dm_nd_enabled()) return ND_EAI_FAIL;
+    const nd_addrinfo *h = hints;
+    const int want = h ? h->ai_socktype : 0;
+    const uint16_t port = nd_service_port(service);
+
+    if (node && *node) {
+        uint32_t addrs[ND_AI_MAX];
+        const int n = dm_nd_lookup(node, addrs, ND_AI_MAX);
+        if (n > 0) {
+            void *head = NULL;
+            for (int i = n - 1; i >= 0; i--)
+                head = nd_ai_new(want ? want : ND_SOCK_STREAM,
+                                 (want ? want : ND_SOCK_STREAM) == ND_SOCK_STREAM ? 6 : 17,
+                                 addrs[i], port, head);
+            if (!head) return ND_EAI_FAIL;
+            *res = head;
+            return 0;
+        }
+    }
+
+    struct addrinfo sys_hints;
+    struct addrinfo *sys = NULL;
+    memset(&sys_hints, 0, sizeof sys_hints);
+    sys_hints.ai_family = AF_INET;                // the host speaks IPv4 only
+    sys_hints.ai_socktype = want;
+    if (want) sys_hints.ai_protocol = want == ND_SOCK_STREAM ? 6 : 17;
+    const int rc = getaddrinfo(node, service, &sys_hints, &sys);
+    if (rc != 0 || !sys) return rc == EAI_NONAME ? ND_EAI_NONAME : ND_EAI_FAIL;
+
+    void *head = NULL;
+    void **tail = &head;
+    int made = 0;
+    for (struct addrinfo *p = sys; p; p = p->ai_next) {
+        if (p->ai_family != AF_INET || !p->ai_addr) continue;
+        const struct sockaddr_in *in = (const struct sockaddr_in *)p->ai_addr;
+        void *ai = nd_ai_new(p->ai_socktype ? p->ai_socktype : (want ? want : ND_SOCK_STREAM),
+                             p->ai_protocol, ntohl(in->sin_addr.s_addr), ntohs(in->sin_port), NULL);
+        if (!ai) continue;
+        *tail = ai;
+        tail = &((nd_addrinfo *)ai)->ai_next;
+        made++;
+    }
+    freeaddrinfo(sys);
+    if (!made) return ND_EAI_FAIL;
+    *res = head;
+    return 0;
+}
+
+void dm_nd_freeai(void *ai) {
+    while (ai) {
+        nd_addrinfo *e = ai;
+        void *next = e->ai_next;
+        free(e->ai_addr);
+        free(e->ai_canonname);
+        free(e);
+        ai = next;
+    }
+}
