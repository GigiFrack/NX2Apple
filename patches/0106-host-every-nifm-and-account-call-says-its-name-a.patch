     (void)h;
     if (!dm_nd_enabled()) return RES_FAIL;
     uint64_t v = 0;
@@ -95,7 +95,7 @@ HLE_FORCE("_ZN2nn7account26GetNetworkServiceAccountIdEPNS0_23NetworkServiceAccou
     if (id) *(uint64_t *)id = v;
     return RES_OK;
 }
-HLE_FORCE("_ZN2nn7account37LoadNetworkServiceAccountIdTokenCacheEPmPcmRKNS0_10UserHandleE", "the application auth token (DM_NEXTENDO=1); cut otherwise", Result, h_acc_LoadTok, uint64_t *n, char *buf, uint64_t sz, const UserHandle *h) {
+HLE_FORCE("_ZN2nn7account37LoadNetworkServiceAccountIdTokenCacheEPmPcmRKNS0_10UserHandleE", "the application auth token (DM_NEXTENDO=1); cut otherwise", Result, h_acc_LoadTok, uint64_t *n, char *buf, uint64_t sz, const UserHandle *h) { dm_nd_trace_result("account::37LoadNetworkServiceAccountIdTokenCache", -1);
     (void)h;
     if (!dm_nd_enabled()) { if (n) *n = 0; return RES_FAIL; }
     // This is the call a game makes to get the id_token it forwards as its NEX login
@@ -111,7 +111,7 @@ HLE_FORCE("_ZN2nn7account37LoadNetworkServiceAccountIdTokenCacheEPmPcmRKNS0_10Us
     if (n) *n = size;
     return RES_OK;
 }
-HLE_FORCE("_ZN2nn7account40ShowLicenseRequirementsForNetworkServiceERKNS0_10UserHandleE", "the online membership notice: nothing to show when the account is the network one", Result, h_acc_ShowLic, const UserHandle *h) {
+HLE_FORCE("_ZN2nn7account40ShowLicenseRequirementsForNetworkServiceERKNS0_10UserHandleE", "the online membership notice: nothing to show when the account is the network one", Result, h_acc_ShowLic, const UserHandle *h) { dm_nd_trace_result("account::40ShowLicenseRequirementsForNetworkService", -1);
     (void)h;
