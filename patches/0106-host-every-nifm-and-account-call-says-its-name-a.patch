     (void)self; (void)buf; (void)sz; if (n) *n = 0; return RES_FAIL;
 }
-HLE_FORCE("_ZN2nn7account42NintendoAccountAuthorizationRequestContext8GetStateEPmPcm", "authorization state string; always fails", Result, h_acc_NaGetState, void *self, uint64_t *n, char *buf, uint64_t sz) {
+HLE_FORCE("_ZN2nn7account42NintendoAccountAuthorizationRequestContext8GetStateEPmPcm", "authorization state string; always fails", Result, h_acc_NaGetState, void *self, uint64_t *n, char *buf, uint64_t sz) { dm_nd_trace_result("account::42NintendoAccountAuthorizationRequestContext8GetState", -1);
