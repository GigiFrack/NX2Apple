From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes <hermes@local>
Date: Thu, 19 Nov 2026 14:44:05 +0000
Subject: [PATCH] host: every nifm and account call says its name at the trace

Upstream-Status: fork-only
Reason: The trace said which answers were given, not which questions were asked, so a gate that answered with a plausible
 value stayed invisible. DM_HLECOUNT cannot help on iPhone (it builds stubs at run time, which iOS forbids), so the
 call is logged where it enters: every nifm and account handler now says its own name through the same trace, and
 nothing is generated.
Issue: https://github.com/GigiFrack/NX2Apple (fork)

---
 dm/host/hle_account.c | 82 +++++++++++++++++++++----------------------
 dm/host/hle_net.c     | 16 ++++-----
 2 files changed, 49 insertions(+), 49 deletions(-)

diff --git a/dm/host/hle_account.c b/dm/host/hle_account.c
index 4178d0e..e3407a6 100644
--- a/dm/host/hle_account.c
+++ b/dm/host/hle_account.c
@@ -14,45 +14,45 @@ _Static_assert(sizeof(Uid) == 16, "Uid");
 static const Uid k_uid = {{0x78626c0000000001ull, 0x53574e4154495645ull}};   // Non-zero means valid
 #define HANDLE_MAGIC 0x55534552484e444cull                                    // "USERHNDL"
 
-HLE_FORCE("_ZN2nn7account10InitializeEv", "connects to the acc:u0 account service; the host has one fixed local user", void, h_acc_Init, void) {}
+HLE_FORCE("_ZN2nn7account10InitializeEv", "connects to the acc:u0 account service; the host has one fixed local user", void, h_acc_Init, void) { dm_nd_trace_result("account::10Initialize", -1);}
 
-HLE_FORCE("_ZN2nn7account13ListOpenUsersEPiPNS0_3UidEi", "list of open users; always the one local user", Result, h_acc_ListOpen, int *n, Uid *out, int max) {
+HLE_FORCE("_ZN2nn7account13ListOpenUsersEPiPNS0_3UidEi", "list of open users; always the one local user", Result, h_acc_ListOpen, int *n, Uid *out, int max) { dm_nd_trace_result("account::13ListOpenUsers", -1);
     *n = 0;
     if (max > 0) { out[0] = k_uid; *n = 1; }
     return RES_OK;
 }
-HLE_FORCE("_ZN2nn7account12ListAllUsersEPiPNS0_3UidEi", "list of all users; always the one local user (Super Mario 3D World + Bowser's Fury)", Result, h_acc_ListAll, int *n, Uid *out, int max) {
+HLE_FORCE("_ZN2nn7account12ListAllUsersEPiPNS0_3UidEi", "list of all users; always the one local user (Super Mario 3D World + Bowser's Fury)", Result, h_acc_ListAll, int *n, Uid *out, int max) { dm_nd_trace_result("account::12ListAllUsers", -1);
     *n = 0;
     if (max > 0) { out[0] = k_uid; *n = 1; }
     return RES_OK;
 }
-HLE_FORCE("_ZN2nn7account16ShowUserSelectorEPNS0_3UidERKNS0_21UserSelectionSettingsE", "user selection applet; the host picks the local user directly", Result, h_acc_ShowSel, Uid *out, const void *settings) { DM_APPLET("user selector");
+HLE_FORCE("_ZN2nn7account16ShowUserSelectorEPNS0_3UidERKNS0_21UserSelectionSettingsE", "user selection applet; the host picks the local user directly", Result, h_acc_ShowSel, Uid *out, const void *settings) { dm_nd_trace_result("account::16ShowUserSelector", -1); DM_APPLET("user selector");
     (void)settings; *out = k_uid; return RES_OK;
 }
 // Take the users the system opened on the application's behalf (Mario 1.2.1 asks this first and falls back to TryOpenPreselectedUser on 0; the game only reads the count, not the return value):
 // the host has no such users and returns 0, so the game opens the preselected user itself, as in v0
-HLE_FORCE("_ZN2nn7account12PopOpenUsersEPiPNS0_10UserHandleEi", "users opened by the system: none (the game falls back to the preselected user)", void, h_acc_PopOpen, int *n, UserHandle *out, int max) { (void)out; (void)max; *n = 0; }
+HLE_FORCE("_ZN2nn7account12PopOpenUsersEPiPNS0_10UserHandleEi", "users opened by the system: none (the game falls back to the preselected user)", void, h_acc_PopOpen, int *n, UserHandle *out, int max) { dm_nd_trace_result("account::12PopOpenUsers", -1); (void)out; (void)max; *n = 0; }
 // Hand the open users to the next program of a multi-program application (Octopath Traveler 0 imports it with oe::ExecuteProgram): the host runs one program, so there is nothing to hand over
-HLE_FORCE("_ZN2nn7account13PushOpenUsersEv", "hand the open users to the next program: the host runs only this one", void, h_acc_PushOpen, void) {}
-HLE_FORCE("_ZN2nn7account22TryOpenPreselectedUserEPNS0_10UserHandleE", "user preselected at launch; always the local user (returns bool)", unsigned, h_acc_TryOpenPre, UserHandle *h) {
+HLE_FORCE("_ZN2nn7account13PushOpenUsersEv", "hand the open users to the next program: the host runs only this one", void, h_acc_PushOpen, void) { dm_nd_trace_result("account::13PushOpenUsers", -1);}
+HLE_FORCE("_ZN2nn7account22TryOpenPreselectedUserEPNS0_10UserHandleE", "user preselected at launch; always the local user (returns bool)", unsigned, h_acc_TryOpenPre, UserHandle *h) { dm_nd_trace_result("account::22TryOpenPreselectedUser", -1);
     h->v[0] = k_uid.v[0]; h->v[1] = k_uid.v[1]; h->v[2] = HANDLE_MAGIC; return 1;
 }
 // The aborting form (Super Mario Odyssey, SDK 7): without the hook the SDK's IPC call fails and aborts with no message. In SDK 6 the same symbol returns a Result, and Fire Emblem: Three Houses
 // skips its save mount when it is non-zero (main+0x53b7e0); returning void left the handle pointer in w0, so the game never mounted "save" and its loading screen waited forever for save:/system.
 // It returns 0 now, which SDK 7+ callers ignore
-HLE_FORCE("_ZN2nn7account19OpenPreselectedUserEPNS0_10UserHandleE", "user preselected at launch (returns a Result in SDK 6, later versions abort on failure); always the local user", Result, h_acc_OpenPre, UserHandle *h) {
+HLE_FORCE("_ZN2nn7account19OpenPreselectedUserEPNS0_10UserHandleE", "user preselected at launch (returns a Result in SDK 6, later versions abort on failure); always the local user", Result, h_acc_OpenPre, UserHandle *h) { dm_nd_trace_result("account::19OpenPreselectedUser", -1);
     h->v[0] = k_uid.v[0]; h->v[1] = k_uid.v[1]; h->v[2] = HANDLE_MAGIC; return RES_OK;
 }
-HLE_FORCE("_ZN2nn7account17GetLastOpenedUserEPNS0_3UidE", "last opened user; always the local user (Super Mario Odyssey)", Result, h_acc_LastOpened, Uid *out) { *out = k_uid; return RES_OK; }
-HLE_FORCE("_ZN2nn7account8OpenUserEPNS0_10UserHandleERKNS0_3UidE", "open user; the handle holds the Uid itself", Result, h_acc_OpenUser, UserHandle *h, const Uid *uid) {
+HLE_FORCE("_ZN2nn7account17GetLastOpenedUserEPNS0_3UidE", "last opened user; always the local user (Super Mario Odyssey)", Result, h_acc_LastOpened, Uid *out) { dm_nd_trace_result("account::17GetLastOpenedUser", -1); *out = k_uid; return RES_OK; }
+HLE_FORCE("_ZN2nn7account8OpenUserEPNS0_10UserHandleERKNS0_3UidE", "open user; the handle holds the Uid itself", Result, h_acc_OpenUser, UserHandle *h, const Uid *uid) { dm_nd_trace_result("account::8OpenUser", -1);
     h->v[0] = uid->v[0]; h->v[1] = uid->v[1]; h->v[2] = HANDLE_MAGIC; return RES_OK;
 }
-HLE_FORCE("_ZN2nn7account9GetUserIdEPNS0_3UidERKNS0_10UserHandleE", "gets the Uid from the handle", Result, h_acc_GetUserId, Uid *out, const UserHandle *h) {
+HLE_FORCE("_ZN2nn7account9GetUserIdEPNS0_3UidERKNS0_10UserHandleE", "gets the Uid from the handle", Result, h_acc_GetUserId, Uid *out, const UserHandle *h) { dm_nd_trace_result("account::9GetUserId", -1);
     if (h->v[2] != HANDLE_MAGIC) die("account::GetUserId: the handle was not issued by the host (%#llx)", h->v[2]);
     out->v[0] = h->v[0]; out->v[1] = h->v[1]; return RES_OK;
 }
 // nn::account::Nickname = struct { char name[33]; }, UTF-8
-HLE_FORCE("_ZN2nn7account11GetNicknameEPNS0_8NicknameERKNS0_3UidE", "user nickname; taken from DM_NICK", Result, h_acc_GetNick, char *nick, const Uid *uid) {
+HLE_FORCE("_ZN2nn7account11GetNicknameEPNS0_8NicknameERKNS0_3UidE", "user nickname; taken from DM_NICK", Result, h_acc_GetNick, char *nick, const Uid *uid) { dm_nd_trace_result("account::11GetNickname", -1);
     (void)uid;
     const char *e = getenv("DM_NICK");
     memset(nick, 0, 33); strncpy(nick, e ? e : "Player", 32);
@@ -68,7 +68,7 @@ static int nd_has_token(void) {
     return dm_nd_enabled() && t && *t;
 }
 
-HLE_FORCE("_ZN2nn7account36EnsureNetworkServiceAccountAvailableERKNS0_10UserHandleE", "network service account: the game token's identity when one is set, else the dauth chain (DM_NEXTENDO=1); cut otherwise", Result, h_acc_EnsureNsa, const UserHandle *h) {
+HLE_FORCE("_ZN2nn7account36EnsureNetworkServiceAccountAvailableERKNS0_10UserHandleE", "network service account: the game token's identity when one is set, else the dauth chain (DM_NEXTENDO=1); cut otherwise", Result, h_acc_EnsureNsa, const UserHandle *h) { dm_nd_trace_result("account::36", -1);
     (void)h;
     if (!dm_nd_enabled()) return RES_FAIL;
     if (nd_has_token()) { dm_nd_trace_result("account::EnsureNetworkServiceAccount(token)", RES_OK); return RES_OK; }
@@ -80,7 +80,7 @@ HLE_FORCE("_ZN2nn7account36EnsureNetworkServiceAccountAvailableERKNS0_10UserHand
 // the `pid` that token proves (`DM_NEXTENDO_PID`): the server binds the login to the account the signed
 // `nnex` claim names, so an id this host made up on its own would be refused. Without one, the old
 // device-derived id stands.
-HLE_FORCE("_ZN2nn7account26GetNetworkServiceAccountIdEPNS0_23NetworkServiceAccountIdERKNS0_10UserHandleE", "the Nextendo pid when DM_NEXTENDO_PID is set, else an id stable per device (DM_NEXTENDO=1); cut otherwise", Result, h_acc_GetNsaId, void *id, const UserHandle *h) {
