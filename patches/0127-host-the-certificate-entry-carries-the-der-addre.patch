--- a/dm/host/hle_ssl_ca.h
+++ b/dm/host/hle_ssl_ca.h
@@ -12,9 +12,12 @@
 // NintendoCAG3 (CaCertificateId 1) as soon as it has a name for the NPLN front end, and an empty answer
 // stops it before it opens a socket: err::ShowError 0x270141, and not one nnsocketSocket in the trace.
 //
-// The answer is an array of BuiltInCertificateInfo (0x18 bytes: id, status, der_size, der_offset) closed by
-// the terminator entry (id All = -1), with the DER data behind the table and every der_offset counted from
-// the start of the buffer.
+// The answer is an array of BuiltInCertificateInfoBase (0x18 bytes: cert id, status, der_size, der data) closed
+// by the terminator entry (id All = -1), with the DER data behind the table. The fourth word is a POINTER, not
+// an offset: the offset is the service's wire format (nn::ssl::sf::BuiltInCertificateInfo, what Ryujinx and
+// Citron build), and it is this library entry's job to turn it into something the caller can dereference.
+// Super Mario Party Jamboree says so itself: handed a der_offset of 0x30 it died on sig=11 at address 0x30 with
+// the size (849) still live in three registers.
 //
 // Two sources, in this order:
 //   <game data>/certs/<id>.der   a certificate the user dropped there (their own console's store, out of
@@ -176,9 +179,11 @@ static size_t dm_ssl_ca_size(const unsigned *ids, unsigned n) {
 }
 
 // Writes that store and returns its size (0 when the buffer is too small, or nothing could be written).
-// `entries` reports how many certificates went in, `from_file` whether the first one came from a file.
+// `entries` reports how many certificates went in, `from_file` whether the first one came from a file, and
+// `as_pointer` picks what the fourth word holds: the address of the DER (the library's class) or its offset
+// from the start of the buffer (the service's struct).
 static size_t dm_ssl_ca_build(const unsigned *ids, unsigned n, unsigned char *buf, size_t cap,
-                              unsigned *entries, size_t *der_size, int *from_file) {
+                              unsigned *entries, size_t *der_size, int *from_file, int as_pointer) {
     size_t need = dm_ssl_ca_size(ids, n);
     if (entries) *entries = 0;
     if (der_size) *der_size = 0;
@@ -197,9 +202,10 @@ static size_t dm_ssl_ca_build(const unsigned *ids, unsigned n, unsigned char *bu
         uint32_t *slot = (uint32_t *)(void *)(buf + (size_t)j * DM_SSL_CA_INFO);
         slot[0] = id;
         slot[1] = DM_SSL_CA_TRUSTED;
-        uint64_t size = (uint64_t)len, off = (uint64_t)at;
+        uint64_t size = (uint64_t)len;
+        uint64_t where = as_pointer ? (uint64_t)(uintptr_t)(buf + at) : (uint64_t)at;
         memcpy(slot + 2, &size, 8);                            // der_size
-        memcpy(slot + 4, &off, 8);                             // der_offset
+        memcpy(slot + 4, &where, 8);                           // der data: a pointer, or its offset
         int file = 0;
         if (dm_ssl_ca_copy(id, buf + at, cap - at, &file) != len) return 0;
         if (!j) { if (der_size) *der_size = len; if (from_file) *from_file = file; }
