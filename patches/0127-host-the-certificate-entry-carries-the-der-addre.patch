 // nnsocketSocket in the trace). The chain a game reads here is never what decides the handshake - that one
 // runs on SecureTransport, with verification skipped for the redirected hosts.
+//
+// The size entry below is one function for both spellings, so it describes the store the SDK 17 spelling
+// serves; the spelling this file answers (nn::ssl::BuiltInCertificateInfo) gets the terminator and nothing
+// else, for the reason on its own comment.
 SSF("_ZN2nn3ssl14BuiltInManager28GetBuiltInCertificateBufSizeEPjPNS0_15CaCertificateIdEj", h_ssl_BiBufSize, uint32_t *o, void *ids, unsigned n) {
     if (!dm_nd_enabled()) { if (o) *o = 0; return RES_FAIL; }
     size_t size = dm_ssl_ca_size((const unsigned *)ids, n);
@@ -90,13 +94,21 @@ SSF("_ZN2nn3ssl14BuiltInManager28GetBuiltInCertificateBufSizeEPjPNS0_15CaCertifi
 }
 SSF("_ZN2nn3ssl14BuiltInManager22GetBuiltInCertificatesEPPNS1_22BuiltInCertificateInfoEPhjPNS0_15CaCertificateIdEj", h_ssl_BiCerts, void **o, uint8_t *b, unsigned bs, void *ids, unsigned n) {
     if (!dm_nd_enabled()) { if (o) *o = NULL; return RES_FAIL; }
-    unsigned entries = 0; size_t der = 0; int file = 0;
-    size_t size = dm_ssl_ca_build((const unsigned *)ids, n, b, bs, &entries, &der, &file);
-    if (o) *o = size ? (void *)b : NULL;
-    { char t[144]; snprintf(t, sizeof t, "ssl::BuiltInCertificates(buf=%p size=%u ids=%u) -> %u certificate(s), der %zu %s",
-                             (void *)b, bs, n, entries, der, file ? "from certs/<id>.der" : "built-in");
-      dm_nd_trace_result(t, (long long)entries); }
-    return size ? RES_OK : RES_FAIL;
+    (void)ids; (void)n;
+    // The store is served through the other spelling (hle_offline.c, SDK 17's BuiltInCertificateInfoBase), the
+    // one this host has measured: 0x18 bytes holding the DER's address. This name is a class derived from it,
+    // and a class with one field more makes the caller's stride wider than 0x18 - an entry here would hand it
+    // DER bytes to read as the next entry. So this spelling keeps the empty answer it always gave: one
+    // terminator, which no stride can overshoot, and a caller that reads no certificates at all.
+    if (b && bs >= 0x18) {
+        uint32_t *e = (uint32_t *)b;
+        e[0] = DM_SSL_CA_ALL; e[1] = 0; e[2] = e[3] = e[4] = e[5] = 0;
+        if (o) *o = b;
+    } else if (o) *o = NULL;
+    { char t[128]; snprintf(t, sizeof t, "ssl::BuiltInCertificates(buf=%p size=%u ids=%u) -> terminator only (class layout unmeasured)",
+                            (void *)b, bs, n);
+      dm_nd_trace_result(t, 0); }
+    return RES_OK;
 }
