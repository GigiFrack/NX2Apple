     setenv("DM_NEXTENDO_HTTPS_PORT", port, 1);
     setenv("DM_NEXTENDO_TLS_INSECURE", "1", 1);
     setenv("DM_NEXTENDO_HOSTS", "127.0.0.1 dauth.local\n127.0.0.1 aauth.local", 1);   // <ip> <name>
+    setenv("DM_NEXTENDO_APP_ID", "0100152000022000", 1);
     dm_nd_reload();
 
     char token[256] = {0};
     if (dm_dauth_application_token("0100152000022000", "0", token, sizeof token)) fail("the chain returned a token");
     if (strcmp(token, "APP-TOKEN-42")) fail("the token is the server's");
 
+    // the identity nn::account reads before a game may go online
+    if (!dm_acc_nsa_available()) fail("the network service account is available");
+    uint64_t id = 0;
+    if (dm_acc_nsa_id(&id) || !id) fail("a stable account id");
+    char nsa[256] = {0};
+    uint64_t sz = sizeof nsa;
+    if (dm_acc_nsa_token(nsa, &sz) || strcmp(nsa, "APP-TOKEN-42")) fail("the account token");
+    sz = 0;
+    if (dm_acc_nsa_token(NULL, &sz) || sz != strlen("APP-TOKEN-42")) fail("the token's size without a buffer");
+
     unsetenv("DM_NEXTENDO");
     dm_nd_reload();
     char refused[256] = {0};
     if (!dm_dauth_application_token("0100152000022000", "0", refused, sizeof refused)) fail("the switch off refuses");
+    if (dm_acc_nsa_available()) fail("no account with the switch off");
 
     puts("ok");
     return 0;
