 dm/host/hle_dauth.c           | 64 +++++++++++++++++++++++++++++++++++
 dm/host/hle_dauth.h           |  7 ++++
 dm/host/tests/t_dauth_local.c | 12 +++++++
 4 files changed, 125 insertions(+), 8 deletions(-)

