-HLE_FORCE("_ZN2nn7account26GetNetworkServiceAccountIdEPNS0_23NetworkServiceAccountIdERKNS0_10UserHandleE", "network service account, out of scope; cut", Result, h_acc_GetNsaId, void *id, const UserHandle *h) { (void)id; (void)h; return RES_FAIL; }
-HLE_FORCE("_ZN2nn7account37LoadNetworkServiceAccountIdTokenCacheEPmPcmRKNS0_10UserHandleE", "network service account token, out of scope; cut", Result, h_acc_LoadTok, uint64_t *n, char *buf, uint64_t sz, const UserHandle *h) {
-    (void)buf; (void)sz; (void)h; if (n) *n = 0; return RES_FAIL;
+HLE_FORCE("_ZN2nn7account36EnsureNetworkServiceAccountAvailableERKNS0_10UserHandleE", "network service account: with Nextendo on, the dauth chain answers (DM_NEXTENDO=1); cut otherwise", Result, h_acc_EnsureNsa, const UserHandle *h) {
+    (void)h;
+    if (!dm_nd_enabled()) return RES_FAIL;
+    return dm_acc_nsa_ensure() ? RES_FAIL : RES_OK;
+}
+HLE_FORCE("_ZN2nn7account26GetNetworkServiceAccountIdEPNS0_23NetworkServiceAccountIdERKNS0_10UserHandleE", "the account id, stable per device (DM_NEXTENDO=1); cut otherwise", Result, h_acc_GetNsaId, void *id, const UserHandle *h) {
+    (void)h;
+    if (!dm_nd_enabled()) return RES_FAIL;
+    uint64_t v;
+    if (dm_acc_nsa_id(&v)) return RES_FAIL;
+    if (id) *(uint64_t *)id = v;
+    return RES_OK;
+}
+HLE_FORCE("_ZN2nn7account37LoadNetworkServiceAccountIdTokenCacheEPmPcmRKNS0_10UserHandleE", "the application auth token (DM_NEXTENDO=1); cut otherwise", Result, h_acc_LoadTok, uint64_t *n, char *buf, uint64_t sz, const UserHandle *h) {
+    (void)h;
+    if (!dm_nd_enabled()) { if (n) *n = 0; return RES_FAIL; }
+    uint64_t size = sz;
+    if (dm_acc_nsa_token(buf, &size)) { if (n) *n = size; return RES_FAIL; }
+    if (n) *n = size;
+    return RES_OK;
+}
+HLE_FORCE("_ZN2nn7account40ShowLicenseRequirementsForNetworkServiceERKNS0_10UserHandleE", "the online membership notice: nothing to show when the account is the network one", Result, h_acc_ShowLic, const UserHandle *h) {
+    (void)h;
