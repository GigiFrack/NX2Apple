index 88725d4..4b33f11 100644
--- a/dm/host/hle_dauth.c
+++ b/dm/host/hle_dauth.c
@@ -17,6 +17,7 @@
 #include <Security/SecureTransport.h>
 #include <Security/Security.h>
 #include <netdb.h>
+#include <pthread.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -140,6 +141,69 @@ static int http_call(const char *host, int port, const char *method, const char
     return status;
 }
 
+// ---------------------------------------------------------------- the identity the games read
+//
+// nn::account asks three things before it lets a game online: is there a network service account,
+// what is its id, and what is its token. On the console the third is a NAS/dauth token; here it is
+// the application auth token the chain above returns, fetched once and kept.
+//
+// The application id is per-game data the launcher knows, so it comes from the environment: with no
+// DM_NEXTENDO_APP_ID there is no network service account at all, which is the offline answer.
+
+static const char *dauth_device_id(void);   // defined below, with the rest of the chain
+
+static pthread_mutex_t g_acc_m = PTHREAD_MUTEX_INITIALIZER;
+static char g_acc_token[4096];
+static int g_acc_state;               // 0 not tried, 1 the token is here, -1 the attempt failed
+
+static const char *acc_app_id(void) {
+    const char *a = getenv("DM_NEXTENDO_APP_ID");
+    return a && *a ? a : NULL;
+}
+
+int dm_acc_nsa_ensure(void) {
+    const char *app = acc_app_id();
+    if (!dm_nd_enabled() || !app) return -1;
+    pthread_mutex_lock(&g_acc_m);
+    if (!g_acc_state) {
+        char token[sizeof g_acc_token];
+        if (dm_dauth_application_token(app, "0", token, sizeof token)) {
+            g_acc_state = -1;
+        } else {
+            snprintf(g_acc_token, sizeof g_acc_token, "%s", token);
+            g_acc_state = 1;
+        }
+    }
+    int ok = g_acc_state > 0;
+    pthread_mutex_unlock(&g_acc_m);
+    return ok ? 0 : -1;
+}
+
+int dm_acc_nsa_available(void) { return dm_acc_nsa_ensure() == 0; }
+
+int dm_acc_nsa_id(uint64_t *out) {
+    // A stable 64-bit id from the device id: the servers key their data on it, so it must not change
+    // between runs, and it must not be the same for two installs.
+    if (!out || dm_acc_nsa_ensure()) return -1;
+    const char *d = dauth_device_id();
+    uint64_t h = 1469598103934665603ull;                 // FNV-1a
+    for (const char *p = d; *p; p++) { h ^= (unsigned char)*p; h *= 1099511628211ull; }
+    *out = h;
+    return 0;
+}
+
+// Horizon's shape: *size is the token's length; a null buffer or a zero size asks for it.
+int dm_acc_nsa_token(char *buf, uint64_t *size) {
+    if (!size || dm_acc_nsa_ensure()) return -1;
+    size_t need = strlen(g_acc_token);
+    uint64_t cap = *size;
+    *size = need;
+    if (!buf || !cap) return 0;
+    if (cap < need) return -1;
+    memcpy(buf, g_acc_token, need);
+    return 0;
+}
+
 // The first string value of a key, unescaped only as far as tokens need (no \u sequences in them).
 static int json_string(const char *json, const char *key, char *out, size_t cap) {
     char pat[64];
