From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes <hermes@local>
Date: Wed, 18 Nov 2026 20:37:04 +0000
Subject: [PATCH] host: with DM_NEXTENDO on, nn::nifm reports a network so a
 game offers its online modes

Upstream-Status: fork-only
Reason: Only the fork has the online seams (DM_NEXTENDO): a game asks nn::nifm whether there is a network
 before it offers anything online, and the cut answer is always no, so Super Mario Party Jamboree showed the
 online guidelines and then went straight back to the cpu|worldwide choice without opening a single socket.
 Off by default: with DM_NEXTENDO unset every answer here is the cut one, byte for byte, including the one
 query of hold Pikmin 4 and Hades depend on.
Issue: https://github.com/GigiFrack/NX2Apple (fork)

---
 dm/host/hle_net.c               | 24 ++++++++++++--
 dm/host/tests/Makefile          |  4 +++
 dm/host/tests/t_nifm_nextendo.c | 56 +++++++++++++++++++++++++++++++++
 3 files changed, 81 insertions(+), 3 deletions(-)
 create mode 100644 dm/host/tests/t_nifm_nextendo.c

diff --git a/dm/host/hle_net.c b/dm/host/hle_net.c
index 009083a..fb48e2e 100644
--- a/dm/host/hle_net.c
+++ b/dm/host/hle_net.c
@@ -1,6 +1,7 @@
 // Network services stay offline. The BSD service additionally supplies process-local UDP and EventFd transports, which offline engines use for their own threads.
 #include "hle.h"
 #include "hle_net.h"
+#include "hle_nextendo.h"   // dm_nd_enabled: the switch the nifm answers below turn on
 #include <pthread.h>
 #include <stdatomic.h>
 
@@ -18,17 +19,34 @@ HLE_FORCE("_ZN2nn4nifm10InitializeEv", "connects to the nifm network management
 // queries, 2,000 IPCs on the Switch but 0.1 ms here, so it cancelled and submitted again forever (1.17 billion queries a minute, a host core). Its stamp, now_ns() | 1, also read
 // as settled at once whenever the next query came within the same 42 ns clock tick (30% of Hades' submissions)
 static _Atomic int g_nifm_hold;   // queries the pending request still answers "on hold" (0 = none, or settled)
-HLE_FORCE("_ZN2nn4nifm20SubmitNetworkRequestEv", "offline: the request is on hold for the first query, then settles as unavailable", void, h_nifm_Submit, void) { atomic_store(&g_nifm_hold, 1); }
+// With DM_NEXTENDO=1 there is a network to ask for, so the request settles at once instead of staying
+// on hold: a game that waits for the hold to end (Jamboree before it shows the online menu) would
+// otherwise wait for a rejection that never turns into a yes.
+HLE_FORCE("_ZN2nn4nifm20SubmitNetworkRequestEv", "offline: the request is on hold for the first query, then settles as unavailable; DM_NEXTENDO=1: it settles at once", void, h_nifm_Submit, void) {
+    atomic_store(&g_nifm_hold, dm_nd_enabled() ? 0 : 1);
+}
 HLE_FORCE("_ZN2nn4nifm20CancelNetworkRequestEv", "offline: drops the pending request", void, h_nifm_Cancel, void) { atomic_store(&g_nifm_hold, 0); }
 HLE_FORCE("_ZN2nn4nifm22IsNetworkRequestOnHoldEv", "offline: on hold for the first query after the submission", int, h_nifm_OnHold, void) {
     int h = atomic_load(&g_nifm_hold);
     while (h > 0 && !atomic_compare_exchange_weak(&g_nifm_hold, &h, h - 1)) {}
     return h > 0;
 }
-HLE_FORCE("_ZN2nn4nifm18IsNetworkAvailableEv", "offline: the network is always unavailable", int, h_nifm_Available, void) { return 0; }
+// The gate a game asks before it offers anything online. Offline it stays a plain no.
+HLE_FORCE("_ZN2nn4nifm18IsNetworkAvailableEv", "offline: the network is always unavailable; DM_NEXTENDO=1 reports it up", int, h_nifm_Available, void) {
+    return dm_nd_enabled() ? 1 : 0;
+}
 // Returns bool (`and w0, w0, #1`, Metroid Dread's sdk+0x336210): whether the system's network screen resolved the error
 HLE_FORCE("_ZN2nn4nifm31HandleNetworkRequestErrorResultEv", "offline: not resolved, shows no system network screen", unsigned, h_nifm_HandleErr, void) { return 0; }
-HLE_FORCE("_ZN2nn4nifm26GetCurrentPrimaryIpAddressEPNS_6socket6InAddrE", "offline: no IP", Result, h_nifm_GetIp, uint32_t *a) { if (a) *a = 0; return RES_FAIL; }
+// 192.168.1.2: the address a game writes into its own profile and never dials. Real, so a game that
+// logs it or compares it with "0.0.0.0" sees a connected console.
+HLE_FORCE("_ZN2nn4nifm26GetCurrentPrimaryIpAddressEPNS_6socket6InAddrE", "offline: no IP; DM_NEXTENDO=1: a connected address", Result, h_nifm_GetIp, uint32_t *a) {
+    if (dm_nd_enabled()) {   // written as bytes: a is network order, so no htonl and no endian guess
+        if (a) { uint8_t *b = (uint8_t *)a; b[0] = 192; b[1] = 168; b[2] = 1; b[3] = 2; }
+        return RES_OK;
+    }
+    if (a) *a = 0;
+    return RES_FAIL;
+}
 HLE_FORCE("_ZN2nn4nifm22GetCurrentProxySettingEPNS0_12ProxySettingE", "offline: no proxy setting", Result, h_nifm_GetProxy, void *p) { (void)p; return RES_FAIL; }
 HLE_FORCE("nnsslInitialize", "connects to the ssl service; the network library's global init needs it to succeed, offline creates no session (cut)", Result, h_ssl_Initialize, void) { return RES_OK; }
 HLE_FORCE("nnsslFinalize", "pairs with nnsslInitialize (cut)", Result, h_ssl_Finalize, void) { return RES_OK; }
diff --git a/dm/host/tests/Makefile b/dm/host/tests/Makefile
index 63b929a..b98b74d 100644
--- a/dm/host/tests/Makefile
+++ b/dm/host/tests/Makefile
@@ -54,6 +54,7 @@ run: $(B)/t_mii $(B)/t_net_eventfd $(B)/t_language $(B)/t_motion $(B)/t_heap_siz
 	$(B)/t_net_udp_remote
 	$(B)/t_nextendo_map
 	$(B)/t_nextendo_gai
+	$(B)/t_nifm_nextendo
 	$(B)/t_sf
 	$(B)/t_audren_sv
 	$(B)/t_time
@@ -251,6 +252,9 @@ $(B)/t_nextendo_map: t_nextendo_map.c ../hle_nextendo.c ../hle_nextendo.h | $(B)
 	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function $(if $(findstring -fsanitize,$(SAN)),,-fsanitize=address,undefined) -I.. -o $@ t_nextendo_map.c
 $(B)/t_nextendo_gai: t_nextendo_gai.c ../hle_nextendo.c ../hle_nextendo_gai.c ../hle_nextendo.h | $(B)
 	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function $(if $(findstring -fsanitize,$(SAN)),,-fsanitize=address,undefined) -I.. -o $@ t_nextendo_gai.c
+# nifm needs the socket service it sits in, so this one takes hle_net.c's dependencies too.
+$(B)/t_nifm_nextendo: t_nifm_nextendo.c ../hle_net.c ../hle_net.h ../hle.h ../dm.h ../hle_nextendo.c ../hle_nextendo.h $(GAME_H) | $(B)
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function $(if $(findstring -fsanitize,$(SAN)),,-fsanitize=address,undefined) -I.. $(GINC) -o $@ t_nifm_nextendo.c
 
 $(B)/t_pctl: t_pctl.c ../hle_misc.c ../hle.h ../dm.h $(GAME_H) | $(B)
 	$(CLANG) -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_pctl.c
diff --git a/dm/host/tests/t_nifm_nextendo.c b/dm/host/tests/t_nifm_nextendo.c
new file mode 100644
index 0000000..78308e6
--- /dev/null
+++ b/dm/host/tests/t_nifm_nextendo.c
@@ -0,0 +1,56 @@
+// The first gate a game asks before it offers anything online: nn::nifm must say there is a network.
+// Offline it answers "unavailable" (Pikmin 4 and Hades depend on the exact shape of that, see the
+// comment on g_nifm_hold in hle_net.c); with DM_NEXTENDO=1 it answers "up", at once and consistently.
+#include "../hle_net.c"
+#include "../hle_nextendo.c"   // dm_nd_enabled: the switch these answers read
+__thread _Atomic int dm_host_work;
+#include <assert.h>
+#include <stdio.h>
+#include <time.h>
+
+void dm_guest_sleep_ns(int64_t ns) { struct timespec ts = {ns / 1000000000, ns % 1000000000}; nanosleep(&ts, NULL); }
+#if defined(__APPLE__)
+void dm_guest_cond_wait_ns(pthread_cond_t *c, pthread_mutex_t *m, int64_t ns) { struct timespec ts = {ns / 1000000000, ns % 1000000000}; pthread_cond_timedwait_relative_np(c, m, &ts); }
+#else
+// The host tests run on macOS, this one also runs on the Linux box that does the cross checks.
+void dm_guest_cond_wait_ns(pthread_cond_t *c, pthread_mutex_t *m, int64_t ns) {
+    struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts);
+    uint64_t at = (uint64_t)ts.tv_nsec + (uint64_t)(ns < 0 ? 0 : ns);
+    ts.tv_sec += (time_t)(at / 1000000000u); ts.tv_nsec = (long)(at % 1000000000u);
+    pthread_cond_timedwait(c, m, &ts);
+}
+#endif
+uint64_t guest_ns(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return (uint64_t)ts.tv_sec * 1000000000u + (uint64_t)ts.tv_nsec; }
+int dm_detclock_enabled(void) { return 0; }
+
+int main(void) {
+    uint32_t ip = 0xFFFFFFFFu;
+
+    // ---- offline: byte for byte what the cut feature did before
+    unsetenv("DM_NEXTENDO");
+    assert(h_nifm_Available() == 0);
+    assert(h_nifm_GetIp(&ip) == RES_FAIL);
+    assert(ip == 0);
+    h_nifm_Submit();                       // on hold for exactly one query, then settled
+    assert(h_nifm_OnHold() == 1);
+    assert(h_nifm_OnHold() == 0);
+    printf("offline: unavailable, hold then settled, no IP\n");
+
+    // ---- DM_NEXTENDO=1: the console is on a network
+    setenv("DM_NEXTENDO", "1", 1);
+    assert(h_nifm_Available() == 1);
+    h_nifm_Submit();                       // settles at once: nothing to wait for
+    assert(h_nifm_OnHold() == 0);
+    ip = 0;
+    assert(h_nifm_GetIp(&ip) == RES_OK);
+    assert(ip != 0);
+    assert(h_nifm_Available() == 1);       // still up on the next query
+    printf("nextendo: available, settles at once, IP %u.%u.%u.%u\n",
+           ip >> 24, (ip >> 16) & 255, (ip >> 8) & 255, ip & 255);
+
+    // ---- and off again: the switch is read on every call, so the cut answers come back
+    unsetenv("DM_NEXTENDO");
+    assert(h_nifm_Available() == 0);
+    printf("ok\n");
+    return 0;
+}
