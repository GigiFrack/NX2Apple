From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes <hermes@local>
Date: Wed, 18 Nov 2026 05:48:44 +0000
Subject: [PATCH] tests: CoreFoundation for CFRelease, and a TLS server that
 survives a bare port probe
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The TLS test links -framework Security but CFRelease lives in CoreFoundation; the host app got it
through Cocoa, a bare clang link does not. The workflow's nc probe opened a connection and closed
it, which the server saw as a broken handshake and died on — it now skips a connection that is not
TLS and keeps listening.

Upstream-Status: fork-only
Reason: it is part of the TLS test (0067), which upstream has nothing to run; a bare clang link needs CoreFoundation explicitly and the workflow's port probe must not kill the server
Issue: none opened yet — folds into the same PR as 0066/0067

---
 dm/host/tests/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dm/host/tests/Makefile b/dm/host/tests/Makefile
index f284c4b..838b621 100644
--- a/dm/host/tests/Makefile
+++ b/dm/host/tests/Makefile
@@ -242,7 +242,7 @@ $(B)/t_net_udp_remote: t_net_udp_remote.c ../hle_net.c ../hle_net.h ../hle_nexte
 	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function $(if $(findstring -fsanitize,$(SAN)),,-fsanitize=address,undefined) -I.. $(GINC) -o $@ t_net_udp_remote.c
 # The TLS test speaks to a server the caller starts (DM_TEST_TLS_PORT), so it is not in `run`.
 $(B)/t_ssl_local: t_ssl_local.c ../hle_net.c ../hle_ssl.c ../hle_ssl.h ../hle_nextendo.c ../hle_nextendo.h ../hle.h ../dm.h $(GAME_H) | $(B)
-	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_ssl_local.c -framework Security
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_ssl_local.c -framework Security -framework CoreFoundation
 # The Nextendo hostname map and resolver are plain C with no game profile: these tests build without GAME.
 $(B)/t_nextendo_map: t_nextendo_map.c ../hle_nextendo.c ../hle_nextendo.h | $(B)
 	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function $(if $(findstring -fsanitize,$(SAN)),,-fsanitize=address,undefined) -I.. -o $@ t_nextendo_map.c
