--- a/dm/host/tests/Makefile
+++ b/dm/host/tests/Makefile
@@ -50,6 +50,7 @@ run: $(B)/t_mii $(B)/t_net_eventfd $(B)/t_language $(B)/t_motion $(B)/t_heap_siz
 	$(B)/t_pctl
 	$(B)/t_net_eventfd
 	$(B)/t_net_loopback
+	$(B)/t_nextendo_map
 	$(B)/t_sf
 	$(B)/t_audren_sv
 	$(B)/t_time
@@ -232,6 +233,9 @@ $(B)/t_net_eventfd: t_net_eventfd.c ../hle_net.c ../hle_net.h ../hle.h ../dm.h $
 run: $(B)/t_net_loopback
