diff --git a/dm/host/tests/t_nextendo_map.c b/dm/host/tests/t_nextendo_map.c
new file mode 100644
index 0000000..d540f2b
--- /dev/null
+++ b/dm/host/tests/t_nextendo_map.c
@@ -0,0 +1,69 @@
+// The Nextendo hostname map: retail names answer with the map's addresses, nothing else moves,
+// and with DM_NEXTENDO unset the map does not exist at all.
+#include "../hle_nextendo.c"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static void expect(int cond, const char *what) {
+    if (!cond) {
+        fprintf(stderr, "not true: %s\n", what);
+        exit(1);
+    }
+}
+
+int main(void) {
+    unsetenv("DM_NEXTENDO_HOSTS_FILE");
+    setenv("DM_NEXTENDO", "1", 1);
+    setenv("DM_NEXTENDO_HOSTS",
+           "# the names a game asks for, and where they go\n"
+           "10.0.0.9 g2b309e01-0000000000000000.srv.nintendo.net\n"
+           "10.0.0.9 *.ndas.srv.nintendo.net\n"
+           "10.0.0.10 nncs1-lp1.n.n.srv.nintendo.net\n"
+           "not-an-address *.example.org\n"
+           "   \n", 1);
+    dm_nd_reload();
+    expect(dm_nd_rule_count() == 3, "three usable rules (comments, blanks and a bad IP dropped)");
+
+    uint32_t got[4] = {0};
+    expect(dm_nd_lookup("g2b309e01-0000000000000000.srv.nintendo.net", got, 4) == 1, "exact name mapped");
+    expect(got[0] == 0x0A000009u, "exact name gives 10.0.0.9");
+
+    got[0] = 0;
+    expect(dm_nd_lookup("AAUTH-LP1.NDAS.SRV.NINTENDO.NET", got, 4) == 1, "match is case-insensitive");
+    expect(got[0] == 0x0A000009u, "wildcard gives 10.0.0.9");
+
+    expect(dm_nd_lookup("ndas.srv.nintendo.net", got, 4) == 0, "the bare suffix is not a wildcard match");
+    expect(dm_nd_lookup("nncs1-lp1.n.n.srv.nintendo.net", got, 4) == 1, "second rule's name mapped");
+    expect(dm_nd_lookup("example.com", got, 4) == 0, "a name nobody listed is not mapped");
+    expect(dm_nd_lookup("*.example.org", got, 4) == 0, "a bad address never becomes a rule");
+
+    setenv("DM_NEXTENDO", "0", 1);
+    dm_nd_reload();
+    expect(dm_nd_rule_count() == 0, "no rules with the switch off");
+    expect(dm_nd_lookup("g2b309e01-0000000000000000.srv.nintendo.net", got, 4) == 0,
+           "nothing is mapped with the switch off");
+
+    unsetenv("DM_NEXTENDO");
+    expect(dm_nd_enabled() == 0, "the switch is off when unset");
+
+    // the launcher's per-game file, used when no inline table is given
+    char path[] = "/tmp/t_nextendo_map_XXXXXX";
+    int fd = mkstemp(path);
+    expect(fd >= 0, "temp file");
+    FILE *fp = fdopen(fd, "w");
+    fputs("10.1.2.3 aauth-lp1.ndas.srv.nintendo.net\n", fp);
+    fclose(fp);
+    setenv("DM_NEXTENDO", "1", 1);
+    unsetenv("DM_NEXTENDO_HOSTS");
+    setenv("DM_NEXTENDO_HOSTS_FILE", path, 1);
+    dm_nd_reload();
+    expect(dm_nd_lookup("aauth-lp1.ndas.srv.nintendo.net", got, 4) == 1, "a rule read from the file");
+    expect(got[0] == 0x0A010203u, "the file's address");
+    unlink(path);
+
+    puts("ok");
+    return 0;
+}
