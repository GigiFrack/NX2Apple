From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes <hermes@local>
Date: Fri, 20 Nov 2026 14:04:02 +0000
Subject: [PATCH] host: the network clock answers for an online console

Upstream-Status: fork-only
Reason: A title that wants a network-synced clock before online play asks this task for its result, and the host
 answered failure unconditionally - a decision taken when the console was always offline. With DM_NEXTENDO on
 the console is online and the answer is success. Super Mario Party Jamboree is the case that found it: it
 calls GetResult, then Finalize, then shows its own 0x2A2 without ever resolving a name, so the whole online
 path was being abandoned one call before the network. Offline the answer stays failure: there is nothing to
 sync with, and a title that handles that degradation keeps doing so.
Issue: https://github.com/GigiFrack/NX2Apple (fork)

---
 dm/host/hle_sdk16.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/dm/host/hle_sdk16.c b/dm/host/hle_sdk16.c
index 2c7ebc8..fbb181e 100644
--- a/dm/host/hle_sdk16.c
+++ b/dm/host/hle_sdk16.c
@@ -1,6 +1,7 @@
 // System service interfaces used by games on newer SDKs (16.x): oe / time / pl (shared font) / vi vsync / diag.
 // On the real device all of these go through Horizon system services (IPC); the host gives values directly or makes them "unavailable".
 #include "hle.h"
+#include "hle_nextendo.h"   // dm_nd_enabled: whether the console is on Nextendo (the network clock answers for it)
 #include <fcntl.h>
 #include <pthread.h>
 #include <pthread/qos.h>
@@ -39,14 +40,17 @@ HLE_FORCE("_ZN2nn4time21GetDeviceLocationNameEPNS0_12LocationNameE", "device tim
     memset(out, 0, 0x24); tzset(); strlcpy(out, tzname[0] && *tzname[0] ? tzname[0] : "UTC", 0x24); return RES_OK;
 }
 HLE_FORCE("_ZN2nn4time8FinalizeEv", "pairs with Initialize; the host has no session", Result, h_time_Finalize, void) { return RES_OK; }
-// "Ensure network clock availability" async task: no request is sent; the finish event fires immediately and the result is failure. The object itself is untouched (constructor / destructor no-ops), the event lives in host static storage
+// "Ensure network clock availability" async task: no request is sent and the finish event fires at once. The object itself is untouched (constructor / destructor no-ops), the event lives in host static storage.
+// The result follows the console: offline it is a failure (nothing to sync with), with DM_NEXTENDO on the console is online and it succeeds.
+// A title that wants a network-synced clock before online play asks for it and gives up with its own error when the answer is failure: Super Mario Party Jamboree
+// calls GetResult here and shows 0x2A2 one instruction later, with no name resolved yet.
 static _Alignas(16) uint8_t g_ev_netclock[0x100];
 HLE_FORCE("_ZN2nn4time39AsyncEnsureNetworkClockAvailabilityTaskC1Ev", "network clock task constructor; the host opens no session", void, h_time_NcCtor, void *self) { (void)self; }
 HLE_FORCE("_ZN2nn4time39AsyncEnsureNetworkClockAvailabilityTaskD1Ev", "network clock task destructor; no session to close", void, h_time_NcDtor, void *self) { (void)self; }
-HLE_FORCE("_ZN2nn4time39AsyncEnsureNetworkClockAvailabilityTask10InitializeENS_2os14EventClearModeE", "network clock task init (offline)", Result, h_time_NcInit, void *self, int mode) { (void)self; (void)mode; return RES_OK; }
-HLE_FORCE("_ZN2nn4time39AsyncEnsureNetworkClockAvailabilityTask9StartTaskEv", "network clock task start: finishes at once with failure", Result, h_time_NcStart, void *self) { (void)self; hle_signal_system_event(g_ev_netclock); return RES_OK; }
+HLE_FORCE("_ZN2nn4time39AsyncEnsureNetworkClockAvailabilityTask10InitializeENS_2os14EventClearModeE", "network clock task init", Result, h_time_NcInit, void *self, int mode) { (void)self; (void)mode; return RES_OK; }
+HLE_FORCE("_ZN2nn4time39AsyncEnsureNetworkClockAvailabilityTask9StartTaskEv", "network clock task start: finishes at once", Result, h_time_NcStart, void *self) { (void)self; hle_signal_system_event(g_ev_netclock); return RES_OK; }
 HLE_FORCE("_ZN2nn4time39AsyncEnsureNetworkClockAvailabilityTask14GetFinishEventEv", "network clock task finish event: already signalled", void *, h_time_NcEvent, void *self) { (void)self; hle_signal_system_event(g_ev_netclock); return g_ev_netclock; }
-HLE_FORCE("_ZN2nn4time39AsyncEnsureNetworkClockAvailabilityTask9GetResultEv", "network clock task result: offline, failure", Result, h_time_NcResult, void *self) { (void)self; return RES_FAIL; }
+HLE_FORCE("_ZN2nn4time39AsyncEnsureNetworkClockAvailabilityTask9GetResultEv", "network clock task result: success while the console is on Nextendo, failure offline", Result, h_time_NcResult, void *self) { (void)self; return dm_nd_enabled() ? RES_OK : RES_FAIL; }
 
 // The host has none of the original system shared fonts (0 standard / 1 Simplified Chinese / 2 Simplified Chinese extension / 3 Traditional Chinese / 4 Korean / 5 Nintendo extension) and uses stand-ins,
 //   one file per type in $DM_FONT_DIR (font_file), all made by dm/tools/make_shared_fonts.py: types 0-4 are unhinted cuts of one source font (macOS's Arial Unicode), each with its type's characters,
